---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
import PageIntro from '@components/PageIntro.astro';
import { experience, education } from '@data/profile';
---
<BaseLayout title="Experience" description="Civil engineering work experience, a survey-camp teaching assignment and education of Balkrishna Jha.">
  <PageIntro eyebrow="Experience" title="Professional experience" description="Engineering roles, technical responsibilities, a consolidated survey-camp teaching assignment and education drawn from my CV." nepaliEyebrow="अनुभव" nepaliTitle="व्यावसायिक अनुभव" nepaliDescription="इन्जिनियरिङ पद, प्राविधिक जिम्मेवारी, सर्वेक्षण क्याम्पको शिक्षण अनुभव र शैक्षिक पृष्ठभूमि।" />
  <section class="content-wrap">
    <Container>
      <div class="experience-section-heading">
        <p class="eyebrow">Employment and assignments</p>
        <h2>Professional timeline</h2>
      </div>
      <div class="experience-timeline">
        {experience.map((item, index) => (
          <article class="experience-entry">
            <div class="experience-entry__side">
              <span class="experience-entry__number">{String(index + 1).padStart(2, '0')}</span>
              <span class="experience-entry__period">{item.period}</span>
            </div>
            <div class="experience-entry__body">
              <h3>{item.title}</h3>
              <p class="experience-entry__organisation">{item.organisation}</p>
              {item.context && <p class="experience-entry__context">{item.context}</p>}
              {item.responsibilities.length > 0 && (
                <ul>
                  {item.responsibilities.map((responsibility) => <li>{responsibility}</li>)}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="experience-section-heading experience-section-heading--spaced">
        <p class="eyebrow">Academic background</p>
        <h2>Education</h2>
      </div>
      <div class="profile-education-list profile-education-list--wide">
        {education.map((item) => (
          <article class="profile-education-item">
            <div class="profile-education-item__top"><strong>{item.qualification}</strong><span>{item.period}</span></div>
            <p>{item.institution}{item.affiliation ? ` | ${item.affiliation}` : ''}</p>
            <span class="profile-result">{item.result}</span>
          </article>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
