---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
---

<BaseLayout title="Admin Dashboard | Balkrishna Jha" description="Portfolio management dashboard" noIndex={true}>
  <div class="admin-wrapper">
    <Container>
      <!-- Auth State: Loading -->
      <div id="auth-loading" class="admin-loading">
        <div class="spinner"></div>
        <p>Connecting to Admin Portal...</p>
      </div>

      <!-- Auth State: Logged Out (Login Box) -->
      <div id="auth-login" class="admin-card admin-login-card" style="display: none;">
        <div class="login-header">
          <span class="admin-badge">Secure Portal</span>
          <h1>Admin Dashboard</h1>
          <p class="text-muted">Sign in with your admin credentials to manage portfolio resources, projects, and files.</p>
        </div>

        <form id="login-form" class="admin-form">
          <div id="login-error" class="admin-alert admin-alert--error" style="display: none;"></div>
          
          <div class="form-group">
            <label for="admin-email">Email Address</label>
            <input type="email" id="admin-email" required placeholder="admin@balkrishnajha.com.np" class="admin-input" autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="admin-password">Password</label>
            <input type="password" id="admin-password" required placeholder="••••••••••••" class="admin-input" autocomplete="current-password" />
          </div>

          <button type="submit" id="login-submit-btn" class="btn btn-primary btn-block">
            Sign In to Dashboard
          </button>
        </form>
      </div>

      <!-- Auth State: Logged In (Full Dashboard) -->
      <div id="auth-dashboard" class="dashboard-container" style="display: none;">
        <!-- Top Admin Header -->
        <header class="dash-header">
          <div>
            <span class="admin-badge">Admin Workspace</span>
            <h1 class="dash-title">Portfolio Manager</h1>
            <p class="text-muted">Logged in as <strong id="user-email-display">admin</strong></p>
          </div>
          <div class="dash-header-actions">
            <a href="/" target="_blank" class="btn btn-outline btn-sm">View Website ↗</a>
            <button id="logout-btn" type="button" class="btn btn-secondary btn-sm">Sign Out</button>
          </div>
        </header>

        <!-- Navigation Tabs -->
        <nav class="dash-tabs" aria-label="Dashboard sections">
          <button type="button" class="dash-tab active" data-tab="overview">📊 Overview</button>
          <button type="button" class="dash-tab" data-tab="resources">📚 Resources</button>
          <button type="button" class="dash-tab" data-tab="projects">🏗️ Projects</button>
          <button type="button" class="dash-tab" data-tab="posts">✍️ Blog Posts</button>
          <button type="button" class="dash-tab" data-tab="storage">📁 File Storage</button>
        </nav>

        <!-- Notification Message Banner -->
        <div id="dash-feedback" class="admin-alert" style="display: none;"></div>

        <!-- TAB 1: OVERVIEW -->
        <section id="tab-overview" class="tab-pane active">
          <div class="stats-grid">
            <div class="stat-card">
              <span class="stat-label">Resources</span>
              <span class="stat-value" id="stat-resources-count">-</span>
              <span class="stat-desc">Notes, Codes & Exam prep</span>
            </div>
            <div class="stat-card">
              <span class="stat-label">Projects</span>
              <span class="stat-value" id="stat-projects-count">-</span>
              <span class="stat-desc">Civil Engineering Case studies</span>
            </div>
            <div class="stat-card">
              <span class="stat-label">Blog Articles</span>
              <span class="stat-value" id="stat-posts-count">-</span>
              <span class="stat-desc">Published articles & drafts</span>
            </div>
            <div class="stat-card">
              <span class="stat-label">Storage Bucket</span>
              <span class="stat-value">Supabase</span>
              <span class="stat-desc">Files & PDF documents</span>
            </div>
          </div>

          <div class="overview-quick-actions admin-card">
            <h3>Quick Actions</h3>
            <div class="action-buttons">
              <button type="button" class="btn btn-primary btn-sm" onclick="document.querySelector('[data-tab=resources]').click();">Add Resource</button>
              <button type="button" class="btn btn-primary btn-sm" onclick="document.querySelector('[data-tab=projects]').click();">Add Project</button>
              <button type="button" class="btn btn-primary btn-sm" onclick="document.querySelector('[data-tab=posts]').click();">Write Blog Post</button>
              <button type="button" class="btn btn-secondary btn-sm" onclick="document.querySelector('[data-tab=storage]').click();">Upload File</button>
            </div>
          </div>
        </section>

        <!-- TAB 2: RESOURCES -->
        <section id="tab-resources" class="tab-pane">
          <div class="tab-header">
            <div>
              <h2>Engineering Resources</h2>
              <p class="text-muted">Manage academic references, Loksewa exam prep, Nepal codes, and technical manuals.</p>
            </div>
            <button type="button" id="toggle-resource-form-btn" class="btn btn-primary btn-sm">+ New Resource</button>
          </div>

          <!-- Add Resource Form Drawer -->
          <div id="resource-form-card" class="admin-card form-drawer" style="display: none;">
            <h3 id="resource-form-title">Add New Resource</h3>
            <form id="resource-form" class="admin-form">
              <input type="hidden" id="resource-id" />
              <div class="form-row">
                <div class="form-group flex-2">
                  <label for="resource-title">Title *</label>
                  <input type="text" id="resource-title" required placeholder="e.g. Nepal Bridge Standard 2075" class="admin-input" />
                </div>
                <div class="form-group flex-1">
                  <label for="resource-category">Category *</label>
                  <select id="resource-category" required class="admin-input">
                    <option value="bachelor">Bachelor Civil Engineering</option>
                    <option value="loksewa">Loksewa</option>
                    <option value="codes">Codes and Laws</option>
                    <option value="engineering-reference">Engineering Reference</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="resource-description">Description / Notes</label>
                <textarea id="resource-description" rows="3" placeholder="Brief summary or reference details..." class="admin-input"></textarea>
              </div>

              <div class="form-row">
                <div class="form-group flex-2">
                  <label for="resource-file-url">File or Link URL</label>
                  <input type="text" id="resource-file-url" placeholder="https://... or upload in File Storage tab" class="admin-input" />
                </div>
                <div class="form-group flex-1">
                  <label for="resource-file-size">File Size (optional)</label>
                  <input type="text" id="resource-file-size" placeholder="e.g. 2.4 MB PDF" class="admin-input" />
                </div>
              </div>

              <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Resource</button>
                <button type="button" id="cancel-resource-btn" class="btn btn-secondary">Cancel</button>
              </div>
            </form>
          </div>

          <!-- Resources List -->
          <div id="resources-list-container" class="admin-list-container">
            <div class="admin-loading-inline">Loading resources...</div>
          </div>
        </section>

        <!-- TAB 3: PROJECTS -->
        <section id="tab-projects" class="tab-pane">
          <div class="tab-header">
            <div>
              <h2>Civil Engineering Projects</h2>
              <p class="text-muted">Manage infrastructure, structural, geotechnical, and hydrology projects.</p>
            </div>
            <button type="button" id="toggle-project-form-btn" class="btn btn-primary btn-sm">+ New Project</button>
          </div>

          <!-- Add Project Form Drawer -->
          <div id="project-form-card" class="admin-card form-drawer" style="display: none;">
            <h3 id="project-form-title">Add New Project</h3>
            <form id="project-form" class="admin-form">
              <input type="hidden" id="project-id" />
              <div class="form-row">
                <div class="form-group flex-2">
                  <label for="project-title">Project Title *</label>
                  <input type="text" id="project-title" required placeholder="e.g. Slope Stability & Retaining Wall Design" class="admin-input" />
                </div>
                <div class="form-group flex-1">
                  <label for="project-slug">Slug (URL path) *</label>
                  <input type="text" id="project-slug" required placeholder="slope-stability-design" class="admin-input" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group flex-1">
                  <label for="project-location">Location</label>
                  <input type="text" id="project-location" placeholder="e.g. Sindhupalchok, Nepal" class="admin-input" />
                </div>
                <div class="form-group flex-1">
                  <label for="project-year">Year</label>
                  <input type="text" id="project-year" placeholder="2025" class="admin-input" />
                </div>
                <div class="form-group flex-1">
                  <label for="project-status">Status</label>
                  <select id="project-status" class="admin-input">
                    <option value="Completed">Completed</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Ongoing">Ongoing</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="project-summary">Summary (Short overview)</label>
                <textarea id="project-summary" rows="2" placeholder="Summary of engineering scope and challenges..." class="admin-input"></textarea>
              </div>

              <div class="form-group">
                <label for="project-description">Detailed Description / Methodology</label>
                <textarea id="project-description" rows="5" placeholder="Detailed engineering approach, calculations, and software used..." class="admin-input"></textarea>
              </div>

              <div class="form-row">
                <div class="form-group flex-1">
                  <label for="project-cover">Cover Image URL</label>
                  <input type="text" id="project-cover" placeholder="https://..." class="admin-input" />
                </div>
                <div class="form-group flex-1">
                  <label for="project-report">Report / Case Study PDF URL</label>
                  <input type="text" id="project-report" placeholder="https://..." class="admin-input" />
                </div>
              </div>

              <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Project</button>
                <button type="button" id="cancel-project-btn" class="btn btn-secondary">Cancel</button>
              </div>
            </form>
          </div>

          <!-- Projects List -->
          <div id="projects-list-container" class="admin-list-container">
            <div class="admin-loading-inline">Loading projects...</div>
          </div>
        </section>

        <!-- TAB 4: BLOG POSTS -->
        <section id="tab-posts" class="tab-pane">
          <div class="tab-header">
            <div>
              <h2>Blog & Technical Articles</h2>
              <p class="text-muted">Draft and publish civil engineering articles and learning insights.</p>
            </div>
            <button type="button" id="toggle-post-form-btn" class="btn btn-primary btn-sm">+ New Post</button>
          </div>

          <!-- Add Post Form Drawer -->
          <div id="post-form-card" class="admin-card form-drawer" style="display: none;">
            <h3 id="post-form-title">Write Technical Post</h3>
            <form id="post-form" class="admin-form">
              <input type="hidden" id="post-id" />
              <div class="form-row">
                <div class="form-group flex-2">
                  <label for="post-title">Article Title *</label>
                  <input type="text" id="post-title" required placeholder="e.g. Design Considerations for RCC Structures in Nepal" class="admin-input" />
                </div>
                <div class="form-group flex-1">
                  <label for="post-slug">Slug (URL) *</label>
                  <input type="text" id="post-slug" required placeholder="rcc-design-considerations-nepal" class="admin-input" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group flex-1">
                  <label for="post-category">Category</label>
                  <input type="text" id="post-category" placeholder="Civil Engineering / Structural" class="admin-input" />
                </div>
                <div class="form-group flex-1">
                  <label for="post-status">Publication Status</label>
                  <select id="post-status" class="admin-input">
                    <option value="draft">Draft (Private)</option>
                    <option value="published">Published (Public)</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="post-excerpt">Excerpt (Brief intro)</label>
                <textarea id="post-excerpt" rows="2" placeholder="Short intro paragraph..." class="admin-input"></textarea>
              </div>

              <div class="form-group">
                <label for="post-content">Article Content (Markdown supported)</label>
                <textarea id="post-content" rows="10" placeholder="Write article content here..." class="admin-input font-mono"></textarea>
              </div>

              <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Article</button>
                <button type="button" id="cancel-post-btn" class="btn btn-secondary">Cancel</button>
              </div>
            </form>
          </div>

          <!-- Posts List -->
          <div id="posts-list-container" class="admin-list-container">
            <div class="admin-loading-inline">Loading articles...</div>
          </div>
        </section>

        <!-- TAB 5: FILE STORAGE -->
        <section id="tab-storage" class="tab-pane">
          <div class="tab-header">
            <div>
              <h2>Supabase Storage (portfolio-assets)</h2>
              <p class="text-muted">Upload PDFs, technical documents, drawings, and images to generate instant links.</p>
            </div>
          </div>

          <div class="admin-card upload-box">
            <h3>Upload New File</h3>
            <p class="text-muted text-sm">Select any PDF, Word document, DWG file, or image to upload directly to your public bucket.</p>
            <div class="file-picker-row">
              <input type="file" id="storage-file-input" class="admin-file-input" />
              <button type="button" id="storage-upload-btn" class="btn btn-primary btn-sm">Upload File</button>
            </div>
            <div id="upload-progress-bar" class="progress-bar-wrap" style="display: none;">
              <div class="progress-bar-fill"></div>
            </div>
          </div>

          <div class="files-header-row">
            <h3>Uploaded Bucket Files</h3>
            <button type="button" id="refresh-files-btn" class="btn btn-secondary btn-sm">🔄 Refresh</button>
          </div>

          <div id="storage-files-container" class="admin-list-container">
            <div class="admin-loading-inline">Loading storage files...</div>
          </div>
        </section>
      </div>
    </Container>
  </div>
</BaseLayout>

<style>
  .admin-wrapper {
    padding: 3rem 0 5rem;
    min-height: 80vh;
  }

  .admin-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6rem 0;
    gap: 1rem;
    color: var(--muted);
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid rgba(16, 24, 39, 0.1);
    border-top-color: #1e3a8a;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .admin-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }

  /* Login Card */
  .admin-login-card {
    max-width: 440px;
    margin: 2rem auto;
    padding: 2.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
  }

  .login-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .login-header h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0.25rem 0 0.5rem;
  }

  /* Form Elements */
  .admin-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.825rem;
    font-weight: 600;
    color: #334155;
  }

  .admin-input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.925rem;
    background: #ffffff;
    color: #0f172a;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .admin-input:focus {
    outline: none;
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
  }

  .form-row {
    display: flex;
    gap: 1rem;
  }

  .flex-1 { flex: 1; }
  .flex-2 { flex: 2; }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
    border: 1px solid transparent;
    text-decoration: none;
  }

  .btn-primary {
    background: #0f172a;
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #1e293b;
  }

  .btn-secondary {
    background: #f1f5f9;
    color: #334155;
    border-color: #cbd5e1;
  }

  .btn-secondary:hover {
    background: #e2e8f0;
  }

  .btn-outline {
    background: transparent;
    color: #0f172a;
    border-color: #cbd5e1;
  }

  .btn-outline:hover {
    background: #f8fafc;
  }

  .btn-sm {
    padding: 0.4rem 0.85rem;
    font-size: 0.8rem;
  }

  .btn-block {
    width: 100%;
  }

  .btn-danger {
    background: #fee2e2;
    color: #991b1b;
    border-color: #fca5a5;
  }

  .btn-danger:hover {
    background: #fecaca;
  }

  /* Alerts */
  .admin-alert {
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-size: 0.85rem;
  }

  .admin-alert--error {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
  }

  .admin-alert--success {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  /* Dashboard Header */
  .dash-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e2e8f0;
    margin-bottom: 1.5rem;
  }

  .dash-title {
    font-size: 1.85rem;
    font-weight: 800;
    margin: 0.25rem 0;
  }

  .dash-header-actions {
    display: flex;
    gap: 0.75rem;
  }

  /* Tabs Navigation */
  .dash-tabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: 2px solid #e2e8f0;
    margin-bottom: 2rem;
    overflow-x: auto;
  }

  .dash-tab {
    padding: 0.75rem 1.25rem;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .dash-tab:hover {
    color: #0f172a;
  }

  .dash-tab.active {
    color: #0f172a;
    border-bottom-color: #0f172a;
  }

  /* Tab Panes */
  .tab-pane {
    display: none;
  }

  .tab-pane.active {
    display: block;
  }

  .tab-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .tab-header h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0;
  }

  /* Cards & Grids */
  .admin-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0.35rem 0;
  }

  .stat-desc {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  /* Table / Item Lists */
  .admin-list-container {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .admin-table th {
    text-align: left;
    padding: 0.85rem 1rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    color: #475569;
    font-weight: 600;
  }

  .admin-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #f1f5f9;
    color: #1e293b;
    vertical-align: middle;
  }

  .admin-table tr:hover td {
    background: #fafafa;
  }

  .badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .badge--category {
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #cbd5e1;
  }

  .badge--published {
    background: #dcfce7;
    color: #166534;
  }

  .badge--draft {
    background: #fef3c7;
    color: #92400e;
  }

  .table-actions {
    display: flex;
    gap: 0.5rem;
  }

  .file-picker-row {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    align-items: center;
  }

  .files-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 2rem 0 1rem;
  }

  .empty-state {
    padding: 3rem 1rem;
    text-align: center;
    color: #64748b;
  }

  .admin-loading-inline {
    padding: 2.5rem;
    text-align: center;
    color: #64748b;
  }

  @media (max-width: 640px) {
    .dash-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .form-row {
      flex-direction: column;
    }
  }
</style>

<script>
  import { supabase } from '@lib/supabase';

  // --- UI References ---
  const authLoading = document.getElementById('auth-loading')!;
  const authLogin = document.getElementById('auth-login')!;
  const authDashboard = document.getElementById('auth-dashboard')!;
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const loginError = document.getElementById('login-error')!;
  const loginSubmitBtn = document.getElementById('login-submit-btn') as HTMLButtonElement;
  const logoutBtn = document.getElementById('logout-btn')!;
  const userEmailDisplay = document.getElementById('user-email-display')!;
  const dashFeedback = document.getElementById('dash-feedback')!;

  // Tabs
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.dash-tab');
  const tabPanes = document.querySelectorAll<HTMLElement>('.tab-pane');

  function showFeedback(message: string, isError = false) {
    dashFeedback.textContent = message;
    dashFeedback.className = `admin-alert ${isError ? 'admin-alert--error' : 'admin-alert--success'}`;
    dashFeedback.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(() => {
      dashFeedback.style.display = 'none';
    }, 4500);
  }

  // Tab switching
  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      tabButtons.forEach(b => b.classList.remove('active'));
      tabPanes.forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(`tab-${target}`)?.classList.add('active');
      if (target === 'resources') loadResources();
      if (target === 'projects') loadProjects();
      if (target === 'posts') loadPosts();
      if (target === 'storage') loadStorageFiles();
      if (target === 'overview') loadOverviewStats();
    });
  });

  // --- Auth Lifecycle ---
  async function checkUserSession() {
    try {
      const { data: { session }, error } = await supabase.auth.getSession();
      if (error) throw error;

      authLoading.style.display = 'none';
      if (session?.user) {
        userEmailDisplay.textContent = session.user.email || 'Admin';
        authLogin.style.display = 'none';
        authDashboard.style.display = 'block';
        loadOverviewStats();
      } else {
        authDashboard.style.display = 'none';
        authLogin.style.display = 'block';
      }
    } catch (err: any) {
      authLoading.style.display = 'none';
      authLogin.style.display = 'block';
      console.error('Auth error:', err);
    }
  }

  // Login handler
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    loginError.style.display = 'none';
    loginSubmitBtn.disabled = true;
    loginSubmitBtn.textContent = 'Verifying...';

    const email = (document.getElementById('admin-email') as HTMLInputElement).value;
    const password = (document.getElementById('admin-password') as HTMLInputElement).value;

    const { data, error } = await supabase.auth.signInWithPassword({ email, password });

    loginSubmitBtn.disabled = false;
    loginSubmitBtn.textContent = 'Sign In to Dashboard';

    if (error) {
      loginError.textContent = error.message;
      loginError.style.display = 'block';
    } else if (data.session) {
      checkUserSession();
    }
  });

  // Logout handler
  logoutBtn?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    checkUserSession();
  });

  // --- STATS OVERVIEW ---
  async function loadOverviewStats() {
    const { count: resCount } = await supabase.from('resources').select('*', { count: 'exact', head: true });
    const { count: projCount } = await supabase.from('projects').select('*', { count: 'exact', head: true });
    const { count: postCount } = await supabase.from('posts').select('*', { count: 'exact', head: true });

    const resNode = document.getElementById('stat-resources-count');
    const projNode = document.getElementById('stat-projects-count');
    const postNode = document.getElementById('stat-posts-count');

    if (resNode) resNode.textContent = String(resCount ?? 0);
    if (projNode) projNode.textContent = String(projCount ?? 0);
    if (postNode) postNode.textContent = String(postCount ?? 0);
  }

  // --- 1. RESOURCES LOGIC ---
  const toggleResFormBtn = document.getElementById('toggle-resource-form-btn');
  const resFormCard = document.getElementById('resource-form-card')!;
  const resForm = document.getElementById('resource-form') as HTMLFormElement;
  const resContainer = document.getElementById('resources-list-container')!;

  toggleResFormBtn?.addEventListener('click', () => {
    resForm.reset();
    (document.getElementById('resource-id') as HTMLInputElement).value = '';
    document.getElementById('resource-form-title')!.textContent = 'Add New Resource';
    resFormCard.style.display = resFormCard.style.display === 'none' ? 'block' : 'none';
  });

  document.getElementById('cancel-resource-btn')?.addEventListener('click', () => {
    resFormCard.style.display = 'none';
  });

  resForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = (document.getElementById('resource-id') as HTMLInputElement).value;
    const title = (document.getElementById('resource-title') as HTMLInputElement).value;
    const category = (document.getElementById('resource-category') as HTMLSelectElement).value;
    const description = (document.getElementById('resource-description') as HTMLTextAreaElement).value;
    const file_url = (document.getElementById('resource-file-url') as HTMLInputElement).value;
    const file_size = (document.getElementById('resource-file-size') as HTMLInputElement).value;

    const payload = { title, category, description, file_url, file_size, is_published: true };

    let res;
    if (id) {
      res = await supabase.from('resources').update(payload).eq('id', id);
    } else {
      res = await supabase.from('resources').insert([payload]);
    }

    if (res.error) {
      showFeedback(`Error: ${res.error.message}`, true);
    } else {
      showFeedback(`Resource "${title}" saved successfully!`);
      resFormCard.style.display = 'none';
      resForm.reset();
      loadResources();
      loadOverviewStats();
    }
  });

  async function loadResources() {
    resContainer.innerHTML = '<div class="admin-loading-inline">Loading resources...</div>';
    const { data, error } = await supabase.from('resources').select('*').order('created_at', { ascending: false });

    if (error) {
      resContainer.innerHTML = `<div class="empty-state">Error loading: ${error.message}</div>`;
      return;
    }

    if (!data || data.length === 0) {
      resContainer.innerHTML = '<div class="empty-state"><p>No resources added yet. Click "+ New Resource" above to add your first resource note or code.</p></div>';
      return;
    }

    let html = `
      <table class="admin-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>File / Link</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
    `;

    data.forEach((item: any) => {
      html += `
        <tr>
          <td><strong>${item.title}</strong><br><small class="text-muted">${item.description || ''}</small></td>
          <td><span class="badge badge--category">${item.category}</span></td>
          <td>${item.file_url ? `<a href="${item.file_url}" target="_blank" class="text-sm">View File ↗</a>` : '<span class="text-muted">-</span>'}</td>
          <td>
            <div class="table-actions">
              <button class="btn btn-secondary btn-sm" onclick="window.editResource('${item.id}')">Edit</button>
              <button class="btn btn-danger btn-sm" onclick="window.deleteResource('${item.id}')">Delete</button>
            </div>
          </td>
        </tr>
      `;
    });

    html += '</tbody></table>';
    resContainer.innerHTML = html;
  }

  (window as any).editResource = async (id: string) => {
    const { data } = await supabase.from('resources').select('*').eq('id', id).single();
    if (data) {
      (document.getElementById('resource-id') as HTMLInputElement).value = data.id;
      (document.getElementById('resource-title') as HTMLInputElement).value = data.title;
      (document.getElementById('resource-category') as HTMLSelectElement).value = data.category;
      (document.getElementById('resource-description') as HTMLTextAreaElement).value = data.description || '';
      (document.getElementById('resource-file-url') as HTMLInputElement).value = data.file_url || '';
      (document.getElementById('resource-file-size') as HTMLInputElement).value = data.file_size || '';
      document.getElementById('resource-form-title')!.textContent = 'Edit Resource';
      resFormCard.style.display = 'block';
      window.scrollTo({ top: resFormCard.offsetTop - 50, behavior: 'smooth' });
    }
  };

  (window as any).deleteResource = async (id: string) => {
    if (!confirm('Are you sure you want to delete this resource?')) return;
    const { error } = await supabase.from('resources').delete().eq('id', id);
    if (error) showFeedback(error.message, true);
    else {
      showFeedback('Resource deleted.');
      loadResources();
      loadOverviewStats();
    }
  };

  // --- 2. PROJECTS LOGIC ---
  const toggleProjFormBtn = document.getElementById('toggle-project-form-btn');
  const projFormCard = document.getElementById('project-form-card')!;
  const projForm = document.getElementById('project-form') as HTMLFormElement;
  const projContainer = document.getElementById('projects-list-container')!;

  toggleProjFormBtn?.addEventListener('click', () => {
    projForm.reset();
    (document.getElementById('project-id') as HTMLInputElement).value = '';
    document.getElementById('project-form-title')!.textContent = 'Add New Project';
    projFormCard.style.display = projFormCard.style.display === 'none' ? 'block' : 'none';
  });

  document.getElementById('cancel-project-btn')?.addEventListener('click', () => {
    projFormCard.style.display = 'none';
  });

  projForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = (document.getElementById('project-id') as HTMLInputElement).value;
    const title = (document.getElementById('project-title') as HTMLInputElement).value;
    const slug = (document.getElementById('project-slug') as HTMLInputElement).value;
    const location = (document.getElementById('project-location') as HTMLInputElement).value;
    const year = (document.getElementById('project-year') as HTMLInputElement).value;
    const status = (document.getElementById('project-status') as HTMLSelectElement).value;
    const summary = (document.getElementById('project-summary') as HTMLTextAreaElement).value;
    const description = (document.getElementById('project-description') as HTMLTextAreaElement).value;
    const cover_image = (document.getElementById('project-cover') as HTMLInputElement).value;
    const report_file_url = (document.getElementById('project-report') as HTMLInputElement).value;

    const payload = { title, slug, location, year, status, summary, description, cover_image, report_file_url };

    let res;
    if (id) {
      res = await supabase.from('projects').update(payload).eq('id', id);
    } else {
      res = await supabase.from('projects').insert([payload]);
    }

    if (res.error) showFeedback(`Error: ${res.error.message}`, true);
    else {
      showFeedback(`Project "${title}" saved successfully!`);
      projFormCard.style.display = 'none';
      projForm.reset();
      loadProjects();
      loadOverviewStats();
    }
  });

  async function loadProjects() {
    projContainer.innerHTML = '<div class="admin-loading-inline">Loading projects...</div>';
    const { data, error } = await supabase.from('projects').select('*').order('created_at', { ascending: false });

    if (error) {
      projContainer.innerHTML = `<div class="empty-state">Error: ${error.message}</div>`;
      return;
    }

    if (!data || data.length === 0) {
      projContainer.innerHTML = '<div class="empty-state"><p>No projects added yet. Click "+ New Project" above.</p></div>';
      return;
    }

    let html = `
      <table class="admin-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Location</th>
            <th>Year</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
    `;

    data.forEach((p: any) => {
      html += `
        <tr>
          <td><strong>${p.title}</strong><br><small class="text-muted">/${p.slug}</small></td>
          <td>${p.location || '-'}</td>
          <td>${p.year || '-'}</td>
          <td><span class="badge badge--published">${p.status}</span></td>
          <td>
            <div class="table-actions">
              <button class="btn btn-danger btn-sm" onclick="window.deleteProject('${p.id}')">Delete</button>
            </div>
          </td>
        </tr>
      `;
    });

    html += '</tbody></table>';
    projContainer.innerHTML = html;
  }

  (window as any).deleteProject = async (id: string) => {
    if (!confirm('Are you sure you want to delete this project?')) return;
    const { error } = await supabase.from('projects').delete().eq('id', id);
    if (error) showFeedback(error.message, true);
    else {
      showFeedback('Project deleted.');
      loadProjects();
      loadOverviewStats();
    }
  };

  // --- 3. POSTS LOGIC ---
  const togglePostFormBtn = document.getElementById('toggle-post-form-btn');
  const postFormCard = document.getElementById('post-form-card')!;
  const postForm = document.getElementById('post-form') as HTMLFormElement;
  const postsContainer = document.getElementById('posts-list-container')!;

  togglePostFormBtn?.addEventListener('click', () => {
    postForm.reset();
    (document.getElementById('post-id') as HTMLInputElement).value = '';
    document.getElementById('post-form-title')!.textContent = 'Write Technical Post';
    postFormCard.style.display = postFormCard.style.display === 'none' ? 'block' : 'none';
  });

  document.getElementById('cancel-post-btn')?.addEventListener('click', () => {
    postFormCard.style.display = 'none';
  });

  postForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = (document.getElementById('post-id') as HTMLInputElement).value;
    const title = (document.getElementById('post-title') as HTMLInputElement).value;
    const slug = (document.getElementById('post-slug') as HTMLInputElement).value;
    const category = (document.getElementById('post-category') as HTMLInputElement).value || 'Civil Engineering';
    const status = (document.getElementById('post-status') as HTMLSelectElement).value;
    const excerpt = (document.getElementById('post-excerpt') as HTMLTextAreaElement).value;
    const content = (document.getElementById('post-content') as HTMLTextAreaElement).value;

    const payload = { title, slug, category, is_published: status === 'published', excerpt, content };

    let res;
    if (id) {
      res = await supabase.from('posts').update(payload).eq('id', id);
    } else {
      res = await supabase.from('posts').insert([payload]);
    }

    if (res.error) showFeedback(`Error: ${res.error.message}`, true);
    else {
      showFeedback(`Post "${title}" saved successfully!`);
      postFormCard.style.display = 'none';
      postForm.reset();
      loadPosts();
      loadOverviewStats();
    }
  });

  async function loadPosts() {
    postsContainer.innerHTML = '<div class="admin-loading-inline">Loading articles...</div>';
    const { data, error } = await supabase.from('posts').select('*').order('created_at', { ascending: false });

    if (error) {
      postsContainer.innerHTML = `<div class="empty-state">Error: ${error.message}</div>`;
      return;
    }

    if (!data || data.length === 0) {
      postsContainer.innerHTML = '<div class="empty-state"><p>No blog posts created yet. Click "+ New Post" above.</p></div>';
      return;
    }

    let html = `
      <table class="admin-table">
        <thead>
          <tr>
            <th>Article</th>
            <th>Category</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
    `;

    data.forEach((p: any) => {
      html += `
        <tr>
          <td><strong>${p.title}</strong><br><small class="text-muted">/${p.slug}</small></td>
          <td><span class="badge badge--category">${p.category}</span></td>
          <td><span class="badge ${p.is_published ? 'badge--published' : 'badge--draft'}">${p.is_published ? 'Published' : 'Draft'}</span></td>
          <td>
            <div class="table-actions">
              <button class="btn btn-danger btn-sm" onclick="window.deletePost('${p.id}')">Delete</button>
            </div>
          </td>
        </tr>
      `;
    });

    html += '</tbody></table>';
    postsContainer.innerHTML = html;
  }

  (window as any).deletePost = async (id: string) => {
    if (!confirm('Are you sure you want to delete this post?')) return;
    const { error } = await supabase.from('posts').delete().eq('id', id);
    if (error) showFeedback(error.message, true);
    else {
      showFeedback('Post deleted.');
      loadPosts();
      loadOverviewStats();
    }
  };

  // --- 4. SUPABASE STORAGE LOGIC ---
  const fileInput = document.getElementById('storage-file-input') as HTMLInputElement;
  const uploadBtn = document.getElementById('storage-upload-btn')!;
  const filesContainer = document.getElementById('storage-files-container')!;
  const refreshFilesBtn = document.getElementById('refresh-files-btn');

  refreshFilesBtn?.addEventListener('click', loadStorageFiles);

  uploadBtn?.addEventListener('click', async () => {
    if (!fileInput.files || fileInput.files.length === 0) {
      alert('Please select a file to upload first.');
      return;
    }

    const file = fileInput.files[0];
    const cleanFileName = `${Date.now()}-${file.name.replace(/\s+/g, '_')}`;

    uploadBtn.setAttribute('disabled', 'true');
    uploadBtn.textContent = 'Uploading...';

    const { error } = await supabase.storage.from('portfolio-assets').upload(cleanFileName, file);

    uploadBtn.removeAttribute('disabled');
    uploadBtn.textContent = 'Upload File';

    if (error) {
      showFeedback(`Upload error: ${error.message}`, true);
    } else {
      showFeedback(`File "${file.name}" uploaded successfully!`);
      fileInput.value = '';
      loadStorageFiles();
    }
  });

  async function loadStorageFiles() {
    filesContainer.innerHTML = '<div class="admin-loading-inline">Loading bucket files...</div>';
    const { data, error } = await supabase.storage.from('portfolio-assets').list('', { limit: 100, sortBy: { column: 'created_at', order: 'desc' } });

    if (error) {
      filesContainer.innerHTML = `<div class="empty-state">Error loading bucket: ${error.message}. Make sure the bucket 'portfolio-assets' exists and is public in Supabase.</div>`;
      return;
    }

    if (!data || data.length === 0) {
      filesContainer.innerHTML = '<div class="empty-state"><p>No files uploaded yet in bucket <strong>portfolio-assets</strong>. Select a file above to upload.</p></div>';
      return;
    }

    let html = `
      <table class="admin-table">
        <thead>
          <tr>
            <th>File Name</th>
            <th>Public URL</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
    `;

    data.forEach((file: any) => {
      const { data: publicUrlData } = supabase.storage.from('portfolio-assets').getPublicUrl(file.name);
      const url = publicUrlData.publicUrl;

      html += `
        <tr>
          <td><strong>${file.name}</strong></td>
          <td><a href="${url}" target="_blank" class="text-sm">View File ↗</a></td>
          <td>
            <div class="table-actions">
              <button class="btn btn-secondary btn-sm" onclick="navigator.clipboard.writeText('${url}'); alert('File URL copied to clipboard!');">Copy Link</button>
              <button class="btn btn-danger btn-sm" onclick="window.deleteStorageFile('${file.name}')">Delete</button>
            </div>
          </td>
        </tr>
      `;
    });

    html += '</tbody></table>';
    filesContainer.innerHTML = html;
  }

  (window as any).deleteStorageFile = async (fileName: string) => {
    if (!confirm(`Are you sure you want to delete "${fileName}"?`)) return;
    const { error } = await supabase.storage.from('portfolio-assets').remove([fileName]);
    if (error) showFeedback(error.message, true);
    else {
      showFeedback('File removed from storage.');
      loadStorageFiles();
    }
  };

  // Kick off initial auth session check
  checkUserSession();
</script>
