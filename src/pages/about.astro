---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
import Icon from '@components/Icon.astro';
---
<BaseLayout title="About" description="A brief profile of Balkrishna Jha, Civil Engineer, with a downloadable CV.">
  <section class="about-minimal">
    <Container>
      <div class="about-minimal__content">
        <div class="about-minimal__photo">
          <img src="/images/profile.jpg" alt="Balkrishna Jha – Civil Engineer" loading="eager" />
        </div>
        <p class="eyebrow">About</p>
        <h1>Balkrishna Jha</h1>
        <p class="about-minimal__profession">Civil Engineer</p>
        <a href="/documents/Balkrishna-Jha-CV.pdf" download="Balkrishna-Jha-CV.pdf" class="button button--primary about-minimal__download">
          Download CV (PDF) <Icon name="download" size={17} />
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
