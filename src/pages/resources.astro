---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
import PageIntro from '@components/PageIntro.astro';
import Icon from '@components/Icon.astro';

const resources = (await getCollection('resources', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0));

const sections = [
  {
    number: '01',
    icon: 'notebook',
    title: 'Bachelor Civil Engineering',
    description: '',
    href: '/resources/bachelor-civil-engineering/',
  },
  {
    number: '02',
    icon: 'library',
    title: 'Loksewa',
    description: '',
    href: '/resources/loksewa/',
  },
  {
    number: '03',
    icon: 'file-text',
    title: 'Codes and Laws',
    description: '',
    href: '/resources/codes-and-laws/',
  },
  {
    number: '04',
    icon: 'library',
    title: 'Engineering Reference',
    description: '',
    href: '/resources/engineering-reference/',
  },
] as const;
---
<BaseLayout title="Engineering Resources" description="Organised civil engineering study resources, Loksewa preparation, Nepal codes and laws, and technical references.">
  <PageIntro
    eyebrow="Reference library"
    title="Engineering resources"
    description="A structured library for academic study, public service examination preparation, engineering practice and technical research."
    nepaliEyebrow="सन्दर्भ पुस्तकालय"
    nepaliTitle="इन्जिनियरिङ स्रोत सामग्री"
    nepaliDescription="शैक्षिक अध्ययन, लोक सेवा परीक्षा तयारी, इन्जिनियरिङ अभ्यास र प्राविधिक अनुसन्धानका लागि व्यवस्थित स्रोत पुस्तकालय।"
  />
  <section class="content-wrap">
    <Container>
      <div class="resource-directory-grid">
        {sections.map((section) => (
          <a class="resource-directory-card" href={section.href}>
            <span class="feature-card__number">{section.number} / LIBRARY</span>
            <span class="resource-directory-icon"><Icon name={section.icon} size={24} /></span>
            <h2>{section.title}</h2>
            <p>{section.description}</p>
            <span class="feature-card__link">Browse resources <Icon name="arrow-right" size={15} /></span>
          </a>
        ))}
      </div>
      <div id="live-resources-section" class="resource-managed-list" style="margin-top: 48px; display: none;">
        <div class="section-heading">
          <p class="eyebrow" data-en="Recently added" data-ne="भर्खरै थपिएका">Recently added</p>
          <h2 data-en="Published resources" data-ne="प्रकाशित स्रोत सामग्री">Published resources</h2>
          <p data-en="Engineering notes, official codes and reference materials." data-ne="इन्जिनियरिङ नोटहरू, आधिकारिक संहिता र सन्दर्भ सामग्रीहरू।">Engineering notes, official codes and reference materials.</p>
        </div>
        <div class="listing-grid" id="live-resources-grid"></div>
      </div>

      {resources.length > 0 && (
        <div class="resource-managed-list" style="margin-top: 48px">
          <div class="section-heading">
            <p class="eyebrow">Recently added</p>
            <h2>Published resources</h2>
            <p>Notes, references and documents added through the content manager.</p>
          </div>
          <div class="listing-grid">
            {resources.map((resource) => (
              <article class="listing-card">
                <div class="listing-meta">
                  <span class="listing-category">{resource.data.category}</span>
                  {resource.data.publishDate && (
                    <span>{resource.data.publishDate.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                  )}
                </div>
                <h2>{resource.data.title}</h2>
                <p>{resource.data.description}</p>
                <a href={`/resources/${resource.id}/`} class="listing-read">
                  Open resource <Icon name="arrow-right" size={15} />
                </a>
              </article>
            ))}
          </div>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>

<script>
  import { supabase } from '@lib/supabase';

  const section = document.getElementById('live-resources-section');
  const grid = document.getElementById('live-resources-grid');

  if (section && grid) {
    const loadLiveResources = async () => {
      const { data, error } = await supabase
        .from('resources')
        .select('*')
        .eq('is_published', true)
        .order('created_at', { ascending: false });

      if (!error && data && data.length > 0) {
        section.style.display = 'block';
        grid.innerHTML = data.map((item: any) => {
          const categoryLabels: Record<string, string> = {
            bachelor: 'Bachelor Civil Engineering',
            loksewa: 'Loksewa',
            codes: 'Codes and Laws',
            'engineering-reference': 'Engineering Reference',
          };
          const categoryName = categoryLabels[item.category] || item.category;
          const date = item.created_at ? new Date(item.created_at).toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' }) : '';

          const filesList = (item.files && Array.isArray(item.files) && item.files.length > 0)
            ? item.files
            : (item.file_url ? [{ title: 'Download / View Resource', url: item.file_url, size: item.file_size }] : []);

          let linksMarkup = '';
          if (filesList.length > 1) {
            linksMarkup = `
              <div class="resource-files-links" style="margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.4rem;">
                ${filesList.map((f: any) => `
                  <a href="${f.url}" target="_blank" rel="noopener noreferrer" class="listing-read" style="display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0.65rem; background: var(--surface-soft); border: 1px solid var(--line); border-radius: 6px; font-size: 0.825rem; text-decoration: none;">
                    <span>📄 ${f.title || 'Download File'}</span>
                    <span style="font-size: 0.75rem; color: var(--muted);">${f.size ? f.size + ' ↗' : '↗'}</span>
                  </a>
                `).join('')}
              </div>
            `;
          } else if (filesList.length === 1) {
            const f = filesList[0];
            linksMarkup = `
              <a href="${f.url}" target="_blank" rel="noopener noreferrer" class="listing-read">
                ${f.title || 'Download / View Resource'} <span aria-hidden="true">↗</span>
              </a>
            `;
          }

          return `
            <article class="listing-card">
              <div class="listing-meta">
                <span class="listing-category">${categoryName}</span>
                ${item.file_size ? `<span>${item.file_size}</span>` : `<span>${date}</span>`}
              </div>
              <h2>${item.title}</h2>
              ${item.description ? `<p>${item.description}</p>` : ''}
              ${linksMarkup}
            </article>
          `;
        }).join('');
      }
    };

    loadLiveResources();
  }
</script>
