---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
import SectionHeading from '@components/SectionHeading.astro';
import EngineeringVisual from '@components/EngineeringVisual.astro';
import NepaliTimeCalendar from '@components/NepaliTimeCalendar.astro';
import CivilFunDesk from '@components/CivilFunDesk.astro';
import Icon from '@components/Icon.astro';
import { featuredAreas, site } from '@data/site';
import { professionalSummary, publication, technicalSkills } from '@data/profile';
---
<BaseLayout title={site.title} description={site.description}>
  <section class="hero hero--portfolio">
    <Container>
      <div class="hero-grid hero-grid--portfolio">
        <div class="hero-copy hero-copy--portfolio">
          <p class="hero-kicker">Civil Engineer <span class="hero-kicker__divider">/</span> Nepal</p>
          <p class="hero-name">Balkrishna Jha</p>
          <h1>Engineering knowledge.<br /><span>Building infrastructure.</span></h1>
          <p class="hero-lead">A professional portfolio of civil engineering experience, infrastructure interests, technical knowledge and practical resources.</p>
          <div class="hero-actions">
            <a href="/projects/" class="button button--primary">Explore projects <Icon name="arrow-up-right" size={16} /></a>
            <a href="/cv/" class="button button--hero-outline">View online CV <Icon name="file-text" size={16} /></a>
          </div>
          <div class="hero-meta" aria-label="Professional areas">
            <span>Engineering practice</span>
            <span>Infrastructure</span>
            <span>Technical learning</span>
          </div>
        </div>
        <div class="hero-visual-wrap">
          <EngineeringVisual />
          <div class="hero-visual-note"><span class="hero-visual-note__index">BJ / 01</span><span>CIVIL ENGINEERING · DESIGN · DELIVERY</span></div>
        </div>
      </div>
    </Container>
    <div class="hero-bottom-rule" aria-hidden="true"></div>
  </section>

  <section class="focus-section" aria-label="Portfolio areas">
    <Container>
      <div class="focus-grid">
        {featuredAreas.map((area) => (
          <a class="focus-card" href={area.href}>
            <span class="focus-card__icon"><Icon name={area.icon} size={23} /></span>
            <span class="focus-card__copy">
              <span class="focus-card__number">{area.number} / FOCUS</span>
              <strong>{area.title}</strong>
              <span>{area.description}</span>
            </span>
            <span class="focus-card__arrow"><Icon name="arrow-up-right" size={17} /></span>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <NepaliTimeCalendar />
  <CivilFunDesk />

  <section class="section home-about-section">
    <Container>
      <div class="home-about-grid">
        <div class="home-about-copy">
          <p class="eyebrow">About the engineer</p>
          <h2>A civil engineer focused on practical work and continuous learning.</h2>
          <p>{professionalSummary}</p>
          <p>My background includes public-sector engineering responsibilities and a part-time survey-camp teaching assignment at Khwopa College of Engineering. This website brings together my professional profile, project documentation, technical writing and practical engineering tools.</p>
          <a href="/about/" class="text-link">More about Balkrishna <Icon name="arrow-right" size={16} /></a>
        </div>
        <div class="home-credentials" aria-label="Profile highlights">
          <article class="credential-card credential-card--featured">
            <span class="credential-card__label">Bachelor in Civil Engineering</span>
            <strong>81.07%</strong>
            <span class="credential-card__detail">Distinction · Khwopa College of Engineering</span>
          </article>
          <article class="credential-card">
            <span class="credential-card__label">Recognition · 2025</span>
            <strong>Best Undergraduate Geotechnical Project</strong>
            <span class="credential-card__detail">Nepal Geotechnical Society · 2025</span>
          </article>
          <article class="credential-card">
            <span class="credential-card__label">Public Service Commission</span>
            <strong>Rank 1</strong>
            <span class="credential-card__detail">Nepal Engineering Service · Civil Group</span>
          </article>
          <article class="credential-card credential-card--wide">
            <span class="credential-card__label">Technical toolkit</span>
            <div class="credential-tags">{technicalSkills.map((skill) => <span>{skill}</span>)}</div>
          </article>
        </div>
      </div>
    </Container>
  </section>

  <section class="section section--soft home-explore-section">
    <Container>
      <SectionHeading eyebrow="Explore the portfolio" title="A clear view of my work and knowledge" description="Browse professional experience, developing project case studies, engineering articles and practical resources." />
      <div class="card-grid">
        <article class="feature-card feature-card--editorial">
          <span class="feature-card__number">01 / EXPERIENCE</span>
          <span class="feature-card__symbol"><Icon name="ruler" size={25} /></span>
          <h3>Professional experience</h3>
          <p>Engineering roles and a field-survey teaching assignment, presented from my CV.</p>
          <a class="feature-card__link" href="/experience/">View experience <Icon name="arrow-right" size={15} /></a>
        </article>
        <article class="feature-card feature-card--editorial">
          <span class="feature-card__number">02 / PROJECTS</span>
          <span class="feature-card__symbol"><Icon name="building-2" size={25} /></span>
          <h3>Infrastructure projects</h3>
          <p>Project case studies will be added as scopes, roles and shareable technical details are confirmed.</p>
          <a class="feature-card__link" href="/projects/">View project portfolio <Icon name="arrow-right" size={15} /></a>
        </article>
        <article class="feature-card feature-card--editorial">
          <span class="feature-card__number">03 / TOOLS</span>
          <span class="feature-card__symbol"><Icon name="calculator" size={25} /></span>
          <h3>Engineering tools</h3>
          <p>Small browser-based utilities designed to make common engineering calculations easier to explore.</p>
          <a class="feature-card__link" href="/tools/">Open engineering tools <Icon name="arrow-right" size={15} /></a>
        </article>
      </div>
    </Container>
  </section>

  <section class="section home-research-section">
    <Container>
      <div class="home-research-grid">
        <div class="home-research-intro">
          <p class="eyebrow">Research and recognition</p>
          <h2>Learning, documenting and sharing engineering knowledge.</h2>
          <p>Alongside professional work, my CV records an undergraduate geotechnical project award for work on headrace tunnels across the Siwalik, Lower Himalaya and Higher Himalaya zones, as well as a co-authored research publication.</p>
          <a href="/cv/" class="text-link">See achievements in my CV <Icon name="arrow-right" size={16} /></a>
        </div>
        <article class="research-feature">
          <div class="research-feature__top"><span>RESEARCH PUBLICATION</span><span>2025</span></div>
          <h3>{publication.title}</h3>
          <p>{publication.authors} {publication.journal}</p>
          <a href={publication.doi} target="_blank" rel="noopener noreferrer">Read publication <Icon name="arrow-up-right" size={15} /></a>
        </article>
      </div>
    </Container>
  </section>

  <section class="section home-final-cta-section">
    <Container>
      <div class="home-final-cta">
        <div>
          <p class="eyebrow">Connect professionally</p>
          <h2>Have an engineering question or a professional enquiry?</h2>
          <p>Use the contact page to find my professional details and profile links.</p>
        </div>
        <a href="/contact/" class="button button--primary">Get in touch <Icon name="arrow-up-right" size={16} /></a>
      </div>
    </Container>
  </section>
</BaseLayout>
