---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
import EngineeringVisual from '@components/EngineeringVisual.astro';
import Icon from '@components/Icon.astro';
import { featuredAreas, site } from '@data/site';
import { professionalSummary, technicalSkills } from '@data/profile';
---
<BaseLayout title={site.title} description={site.description}>
  <section class="hero hero--portfolio">
    <Container>
      <div class="hero-grid hero-grid--portfolio">
        <div class="hero-copy hero-copy--portfolio">
          <div class="public-profile-photo" role="img" aria-label="Professional portrait placeholder">
            <span class="public-profile-photo__monogram">BKJ</span>
            <span class="public-profile-photo__caption" data-en="Profile photo" data-ne="प्रोफाइल तस्बिर">Profile photo</span>
          </div>
          <p class="hero-kicker"><span data-en="Civil Engineer" data-ne="सिभिल इन्जिनियर">Civil Engineer</span> <span class="hero-kicker__divider">/</span> Nepal</p>
          <p class="hero-name">Balkrishna Jha</p>
          <h1><span data-en="Engineering knowledge." data-ne="इन्जिनियरिङ ज्ञान।">Engineering knowledge.</span><br /><span data-en="Building infrastructure." data-ne="पूर्वाधार निर्माण।">Building infrastructure.</span></h1>
          <p class="hero-lead" data-en="A professional portfolio of civil engineering experience, infrastructure interests, technical knowledge and practical resources." data-ne="सिभिल इन्जिनियरिङ अनुभव, पूर्वाधारसम्बन्धी रुचि, प्राविधिक ज्ञान र उपयोगी स्रोतहरूको व्यावसायिक पोर्टफोलियो।">A professional portfolio of civil engineering experience, infrastructure interests, technical knowledge and practical resources.</p>
          <div class="hero-actions">
            <a href="/projects/" class="button button--primary"><span data-en="Explore projects" data-ne="परियोजना हेर्नुहोस्">Explore projects</span> <Icon name="arrow-up-right" size={16} /></a>
          </div>
          <div class="hero-meta" aria-label="Professional areas">
            <span>Engineering practice</span>
            <span>Infrastructure</span>
            <span>Technical learning</span>
          </div>
        </div>
        <div class="hero-visual-wrap">
          <EngineeringVisual />
        </div>
      </div>
    </Container>
    <div class="hero-bottom-rule" aria-hidden="true"></div>
  </section>

  <section class="section home-blog-placeholder-section" aria-label="Blog placeholder">
    <Container>
      <div class="home-blog-placeholder">
        <div>
          <p class="eyebrow">Engineering blog</p>
          <h2>Articles coming soon.</h2>
          <p>Technical notes and practical civil engineering insights are being prepared.</p>
        </div>
        <span class="home-blog-placeholder__mark" aria-hidden="true">BLOG / SOON</span>
      </div>
    </Container>
  </section>

  <section class="focus-section" aria-label="Portfolio areas">
    <Container>
      <div class="focus-grid">
        {featuredAreas.map((area) => (
          <a class="focus-card" href={area.href}>
            <span class="focus-card__icon"><Icon name={area.icon} size={23} /></span>
            <span class="focus-card__copy">
              <span class="focus-card__number">{area.number} / FOCUS</span>
              <strong>{area.title}</strong>
              <span>{area.description}</span>
            </span>
            <span class="focus-card__arrow"><Icon name="arrow-up-right" size={17} /></span>
          </a>
        ))}
      </div>
    </Container>
  </section>


  <section class="section home-about-section">
    <Container>
      <div class="home-about-grid">
        <div class="home-about-copy">
          <p class="eyebrow" data-en="About the engineer" data-ne="इन्जिनियरको परिचय">About the engineer</p>
          <h2 data-en="A civil engineer focused on practical work and continuous learning." data-ne="व्यावहारिक काम र निरन्तर सिकाइमा केन्द्रित सिभिल इन्जिनियर।">A civil engineer focused on practical work and continuous learning.</h2>
          <p>{professionalSummary}</p>
          <p>My background includes public-sector engineering responsibilities and a survey-camp teaching assignment at Khwopa College of Engineering. Explore my experience, projects and practical engineering resources.</p>
          <a href="/about/" class="text-link">More about Balkrishna <Icon name="arrow-right" size={16} /></a>
        </div>
        <div class="home-credentials" aria-label="Profile highlights">
          <article class="credential-card credential-card--featured">
            <span class="credential-card__label">Bachelor in Civil Engineering</span>
            <strong>81.07%</strong>
            <span class="credential-card__detail">Distinction · Khwopa College of Engineering</span>
          </article>
          <article class="credential-card">
            <span class="credential-card__label">Recognition · 2025</span>
            <strong>Best Undergraduate Geotechnical Project</strong>
            <span class="credential-card__detail">Nepal Geotechnical Society · 2025</span>
          </article>
          <article class="credential-card">
            <span class="credential-card__label">Public Service Commission</span>
            <strong>Rank 1</strong>
            <span class="credential-card__detail">Nepal Engineering Service · Civil Group</span>
          </article>
          <article class="credential-card credential-card--wide">
            <span class="credential-card__label">Technical toolkit</span>
            <div class="credential-tags">{technicalSkills.map((skill) => <span>{skill}</span>)}</div>
          </article>
        </div>
      </div>
    </Container>
  </section>


  <section class="section home-final-cta-section">
    <Container>
      <div class="home-final-cta">
        <div>
          <p class="eyebrow">Connect professionally</p>
          <h2>Have an engineering question or a professional enquiry?</h2>
          <p>Use the contact page to find my professional details and profile links.</p>
        </div>
        <a href="/contact/" class="button button--primary">Get in touch <Icon name="arrow-up-right" size={16} /></a>
      </div>
    </Container>
  </section>
</BaseLayout>
