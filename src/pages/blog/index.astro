---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
import PageIntro from '@components/PageIntro.astro';
import Icon from '@components/Icon.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const formatDate = (date: Date) =>
  date.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout
  title="Blog"
  description="Notes and articles on civil engineering, infrastructure, construction and engineering practice."
>
  <PageIntro
    eyebrow="Knowledge & perspective"
    title="Blog"
    description="Notes, explainers and reflections on civil engineering, infrastructure planning, design, construction and professional practice."
    nepaliEyebrow="ज्ञान र दृष्टिकोण"
    nepaliTitle="ब्लग"
    nepaliDescription="सिभिल इन्जिनियरिङ, पूर्वाधार योजना, डिजाइन, निर्माण र व्यावसायिक अभ्याससम्बन्धी लेख तथा व्याख्या।"
  />
  <section class="content-wrap">
    <Container>
      <div id="live-posts-grid" class="listing-grid" style="margin-bottom: 2rem; display: none;"></div>

      <div id="blog-fallback" style="display: none;">
        {posts.length > 0 ? (
          <div class="listing-grid">
            {posts.map((post) => (
              <article class="listing-card">
                {post.data.coverImage && (
                  <img
                    src={post.data.coverImage}
                    alt={post.data.title}
                    loading="lazy"
                    style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px;margin-bottom:16px"
                  />
                )}
                <div class="listing-meta">
                  <span class="listing-category">{post.data.category}</span>
                  <span>{formatDate(post.data.publishDate)}</span>
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <a href={`/blog/${post.id}/`} class="listing-read">
                  Read article <Icon name="arrow-right" size={15} />
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p class="eyebrow" data-en="Engineering Blog" data-ne="इन्जिनियरिङ ब्लग">Engineering Blog</p>
            <h2 data-en="Articles are coming soon." data-ne="लेखहरू चाँडै आउँदैछन्।">Articles are coming soon.</h2>
            <p data-en="New articles, field notes, and technical insights will appear here once published." data-ne="नयाँ लेख, फिल्ड नोट र प्राविधिक विश्लेषणहरू यहाँ प्रकाशित हुँदै जानेछन्।">
              New articles, field notes, and technical insights will appear here once published.
            </p>
          </div>
        )}
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  import { supabase } from '@lib/supabase';

  const grid = document.getElementById('live-posts-grid');
  const fallback = document.getElementById('blog-fallback');

  if (grid) {
    const loadPosts = async () => {
      const { data, error } = await supabase
        .from('posts')
        .select('*')
        .eq('is_published', true)
        .order('created_at', { ascending: false });

      if (!error && data && data.length > 0) {
        grid.style.display = 'grid';
        if (fallback) fallback.style.display = 'none';
        grid.innerHTML = data.map((post: any) => {
          const date = post.created_at ? new Date(post.created_at).toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
          
          const postUrl = `/blog/post/?slug=${encodeURIComponent(post.slug || post.id)}`;
          return `
            <article class="listing-card">
              ${post.cover_image ? `
                <a href="${postUrl}" style="display: block;">
                  <img
                    src="${post.cover_image}"
                    alt="${post.title}"
                    loading="lazy"
                    style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px;margin-bottom:16px"
                  />
                </a>
              ` : ''}
              <div class="listing-meta">
                <span class="listing-category">${post.category || 'Civil Engineering'}</span>
                <span>${date}</span>
              </div>
              <h2>
                <a href="${postUrl}" style="color: inherit; text-decoration: none;">
                  ${post.title}
                </a>
              </h2>
              ${post.excerpt ? `<p>${post.excerpt}</p>` : ''}
              <a href="${postUrl}" class="listing-read">
                Read article <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
            </article>
          `;
        }).join('');
      } else {
        if (fallback) fallback.style.display = 'block';
      }
    };

    loadPosts();
  }
</script>
