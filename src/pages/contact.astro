
---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
import PageIntro from '@components/PageIntro.astro';
import Icon from '@components/Icon.astro';
import { site } from '@data/site';
---

<BaseLayout title="Contact" description="Contact details and professional links for Balkrishna Jha, Civil Engineer.">
  <PageIntro
    eyebrow="Contact"
    title="Connect professionally."
    description="For professional enquiries, technical discussions or collaboration, use the contact details and profile links below."
    nepaliEyebrow="à¤¸à¤®à¥à¤ªà¤°à¥à¤•"
    nepaliTitle="à¤µà¥à¤¯à¤¾à¤µà¤¸à¤¾à¤¯à¤¿à¤• à¤°à¥‚à¤ªà¤®à¤¾ à¤¸à¤®à¥à¤ªà¤°à¥à¤• à¤—à¤°à¥à¤¨à¥à¤¹à¥‹à¤¸à¥à¥¤"
    nepaliDescription="à¤µà¥à¤¯à¤¾à¤µà¤¸à¤¾à¤¯à¤¿à¤• à¤œà¤¿à¤œà¥à¤žà¤¾à¤¸à¤¾, à¤ªà¥à¤°à¤¾à¤µà¤¿à¤§à¤¿à¤• à¤›à¤²à¤«à¤² à¤µà¤¾ à¤¸à¤¹à¤•à¤¾à¤°à¥à¤¯à¤•à¤¾ à¤²à¤¾à¤—à¤¿ à¤¤à¤²à¤•à¤¾ à¤¸à¤®à¥à¤ªà¤°à¥à¤• à¤µà¤¿à¤µà¤°à¤£ à¤° à¤ªà¥à¤°à¥‹à¤«à¤¾à¤‡à¤² à¤²à¤¿à¤™à¥à¤• à¤ªà¥à¤°à¤¯à¥‹à¤— à¤—à¤°à¥à¤¨à¥à¤¹à¥‹à¤¸à¥à¥¤"
  />

  <section class="content-wrap">
    <Container>
      <div class="contact-grid contact-grid--polished">
        <div class="contact-intro-card">
          <p class="eyebrow">Professional enquiries</p>
          <h2>Let’s connect.</h2>
          <p>I welcome professional communication related to civil engineering, infrastructure, technical knowledge and learning.</p>
          <div class="contact-location">
            <Icon name="map-pin" size={18} />
            <span>{site.location}, Nepal</span>
          </div>
        </div>

        <div class="contact-options">
          <a class="contact-option contact-option--link" href={`mailto:${site.email}`}>
            <span class="contact-option__icon"><Icon name="mail" size={20} /></span>
            <span><h2>Email</h2><p>{site.email}</p></span>
            <Icon name="arrow-up-right" size={16} />
          </a>

          <a class="contact-option contact-option--link" href={`tel:${site.phone.replace(/\s/g, '')}`}>
            <span class="contact-option__icon"><Icon name="phone" size={20} /></span>
            <span><h2>Phone</h2><p>{site.phone}</p></span>
            <Icon name="arrow-up-right" size={16} />
          </a>

          <a class="contact-option contact-option--link" href={site.linkedin} target="_blank" rel="noopener noreferrer">
            <span class="contact-option__icon"><Icon name="linkedin" size={20} /></span>
            <span><h2>LinkedIn</h2><p>Professional profile</p></span>
            <Icon name="arrow-up-right" size={16} />
          </a>

          <a class="contact-option contact-option--link" href={site.github} target="_blank" rel="noopener noreferrer">
            <span class="contact-option__icon"><Icon name="github" size={20} /></span>
            <span><h2>GitHub</h2><p>Code and technical work</p></span>
            <Icon name="arrow-up-right" size={16} />
          </a>

          <a class="contact-option contact-option--link" href={site.url} target="_blank" rel="noopener noreferrer">
            <span class="contact-option__icon"><Icon name="globe" size={20} /></span>
            <span><h2>Website</h2><p>balkrishnajha.com.np</p></span>
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
      </div>

      <!-- Support Me section -->
      <section class="support-section" aria-labelledby="support-heading">
        <div class="support-heading">
          <p class="eyebrow">Your support matters</p>
          <h2 id="support-heading">Support Me</h2>
          <p>If you find my website, engineering resources or tools useful, you can support my work by buying me a tea. Every contribution is appreciated!</p>
        </div>

        <div class="support-card">
          <div class="support-card__intro">
            <span class="support-tea-icon" aria-hidden="true">☕</span>
            <div>
              <h3>Buy Me a Tea</h3>
              <p>Choose your preferred payment method below.</p>
            </div>
          </div>

          <div class="support-payment-grid">
            <div class="support-payment">
              <div>
                <h4>eSewa</h4>
                <p class="support-number">9844994437</p>
              </div>
              <button type="button" class="support-copy-button" data-copy-number="9844994437">
                <span aria-hidden="true">⧉</span>
                Copy number
              </button>
              <p class="support-payment__hint">Open eSewa → Send Money → Enter this number.</p>
              <p class="support-copy-status" data-copy-status aria-live="polite"></p>
            </div>

            <div class="support-payment">
              <div>
                <h4>Khalti</h4>
                <p class="support-number">9844994437</p>
              </div>
              <button type="button" class="support-copy-button" data-copy-number="9844994437">
                <span aria-hidden="true">⧉</span>
                Copy number
              </button>
              <p class="support-payment__hint">Open Khalti → Send Money → Enter this number.</p>
              <p class="support-copy-status" data-copy-status aria-live="polite"></p>
            </div>

            <div class="support-payment support-payment--coming">
              <div>
                <h4>ConnectIPS</h4>
                <p class="support-number">Coming soon</p>
              </div>
              <span class="support-coming-label">Payment link to be added</span>
              <p class="support-payment__hint">ConnectIPS payment details will be available here later.</p>
            </div>
          </div>

          <p class="support-thanks">Thank you for supporting independent learning and engineering resources.</p>
        </div>
      </section>
    </Container>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-number]').forEach((button) => {
    button.addEventListener('click', async () => {
      const number = button.dataset.copyNumber;
      const card = button.closest('.support-payment');
      const status = card?.querySelector<HTMLElement>('[data-copy-status]');

      if (!number || !status) return;

      try {
        await navigator.clipboard.writeText(number);
        status.textContent = 'Number copied successfully!';
      } catch {
        status.textContent = 'Copy unavailable. Please copy the number manually.';
      }
    });
  });
</script>

<style>
  .support-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border, #d9dee7);
  }

  .support-heading {
    max-width: 680px;
    margin-bottom: 2rem;
  }

  .support-heading h2 {
    margin: 0.4rem 0 0.75rem;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
  }

  .support-heading > p:last-child {
    color: var(--color-muted, #64748b);
    line-height: 1.7;
  }

  .support-card {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-border, #d9dee7);
    border-radius: 1rem;
    background: var(--color-surface, #fff);
  }

  .support-card__intro {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .support-tea-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    border-radius: 0.85rem;
    background: var(--color-surface-muted, #f1f5f9);
    font-size: 1.8rem;
  }

  .support-card__intro h3 {
    margin: 0 0 0.3rem;
    font-size: 1.3rem;
  }

  .support-card__intro p {
    margin: 0;
    color: var(--color-muted, #64748b);
    font-size: 0.92rem;
  }

  .support-payment-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .support-payment {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--color-border, #d9dee7);
    border-radius: 0.8rem;
  }

  .support-payment h4 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .support-number {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .support-copy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-border, #cbd5e1);
    border-radius: 0.5rem;
    background: var(--color-surface-muted, #f1f5f9);
    color: inherit;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .support-copy-button:hover {
    border-color: var(--color-text, #334155);
  }

  .support-payment__hint {
    margin: 1rem 0 0;
    color: var(--color-muted, #64748b);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .support-copy-status {
    min-height: 1.2rem;
    margin: 0.5rem 0 0;
    color: var(--color-text, #334155);
    font-size: 0.8rem;
  }

  .support-coming-label {
    display: inline-block;
    padding: 0.5rem 0.7rem;
    border: 1px dashed var(--color-border, #cbd5e1);
    border-radius: 0.5rem;
    color: var(--color-muted, #64748b);
    font-size: 0.82rem;
  }

  .support-thanks {
    margin: 1.5rem 0 0;
    color: var(--color-muted, #64748b);
    font-size: 0.88rem;
    text-align: center;
  }

  @media (max-width: 760px) {
    .support-payment-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
