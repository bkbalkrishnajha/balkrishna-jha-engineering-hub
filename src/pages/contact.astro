
---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
import PageIntro from '@components/PageIntro.astro';
import Icon from '@components/Icon.astro';
import { site } from '@data/site';
---

<BaseLayout title="Contact" description="Contact details and professional links for Balkrishna Jha, Civil Engineer.">
  <PageIntro
    eyebrow="Contact"
    title="Connect professionally."
    description="For professional enquiries, technical discussions or collaboration, use the contact details and profile links below."
    nepaliEyebrow="à¤¸à¤®à¥à¤ªà¤°à¥à¤•"
    nepaliTitle="à¤µà¥à¤¯à¤¾à¤µà¤¸à¤¾à¤¯à¤¿à¤• à¤°à¥‚à¤ªà¤®à¤¾ à¤¸à¤®à¥à¤ªà¤°à¥à¤• à¤—à¤°à¥à¤¨à¥à¤¹à¥‹à¤¸à¥à¥¤"
    nepaliDescription="à¤µà¥à¤¯à¤¾à¤µà¤¸à¤¾à¤¯à¤¿à¤• à¤œà¤¿à¤œà¥à¤žà¤¾à¤¸à¤¾, à¤ªà¥à¤°à¤¾à¤µà¤¿à¤§à¤¿à¤• à¤›à¤²à¤«à¤² à¤µà¤¾ à¤¸à¤¹à¤•à¤¾à¤°à¥à¤¯à¤•à¤¾ à¤²à¤¾à¤—à¤¿ à¤¤à¤²à¤•à¤¾ à¤¸à¤®à¥à¤ªà¤°à¥à¤• à¤µà¤¿à¤µà¤°à¤£ à¤° à¤ªà¥à¤°à¥‹à¤«à¤¾à¤‡à¤² à¤²à¤¿à¤™à¥à¤• à¤ªà¥à¤°à¤¯à¥‹à¤— à¤—à¤°à¥à¤¨à¥à¤¹à¥‹à¤¸à¥à¥¤"
  />

  <section class="content-wrap">
    <Container>
      <div class="contact-grid contact-grid--polished">
        <div class="contact-intro-card">
          <p class="eyebrow">Professional enquiries</p>
          <h2>Let’s connect.</h2>
          <p>I welcome professional communication related to civil engineering, infrastructure, technical knowledge and learning.</p>
          <div class="contact-location">
            <Icon name="map-pin" size={18} />
            <span>{site.location}, Nepal</span>
          </div>
        </div>

        <div class="contact-options">
          <div class="contact-option contact-option--email">
            <span class="contact-option__icon"><Icon name="mail" size={20} /></span>
            <span><h2>Email</h2><p>{site.email}</p></span>
            <div class="contact-option-actions">
              <button
                type="button"
                class="contact-action-btn"
                data-contact-copy-btn
                data-email={site.email}
                title="Copy email to clipboard"
                aria-label="Copy email address"
              >
                <span data-contact-copy-icon><Icon name="copy" size={13} /></span>
                <span data-contact-copy-text data-en="Copy" data-ne="कपि">Copy</span>
              </button>
              <a
                href={`https://mail.google.com/mail/?view=cm&fs=1&to=${site.email}`}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-action-btn"
                title="Compose message in Gmail"
                aria-label="Open in Gmail"
              >
                <span>Gmail</span>
                <Icon name="arrow-up-right" size={12} />
              </a>
            </div>
          </div>

          <a class="contact-option contact-option--link" href={`tel:${site.phone.replace(/\s/g, '')}`}>
            <span class="contact-option__icon"><Icon name="phone" size={20} /></span>
            <span><h2>Phone</h2><p>{site.phone}</p></span>
            <Icon name="arrow-up-right" size={16} />
          </a>

          <a class="contact-option contact-option--link" href={site.linkedin} target="_blank" rel="noopener noreferrer">
            <span class="contact-option__icon"><Icon name="linkedin" size={20} /></span>
            <span><h2>LinkedIn</h2><p>Professional profile</p></span>
            <Icon name="arrow-up-right" size={16} />
          </a>

          <a class="contact-option contact-option--link" href={site.github} target="_blank" rel="noopener noreferrer">
            <span class="contact-option__icon"><Icon name="github" size={20} /></span>
            <span><h2>GitHub</h2><p>Code and technical work</p></span>
            <Icon name="arrow-up-right" size={16} />
          </a>

          <a class="contact-option contact-option--link" href={site.url} target="_blank" rel="noopener noreferrer">
            <span class="contact-option__icon"><Icon name="globe" size={20} /></span>
            <span><h2>Website</h2><p>balkrishnajha.com.np</p></span>
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
      </div>

      <section class="contact-form-section" aria-labelledby="contact-form-heading">
        <div class="contact-form-heading">
          <p class="eyebrow">Send a message</p>
          <h2 id="contact-form-heading">Have an enquiry?</h2>
          <p>Use the form below to send a message directly. I’ll get back to you by email.</p>
        </div>

        <form class="contact-form" id="contact-form" action="/api/contact" method="POST">
          <div class="contact-form__grid">
            <label>
              <span>Your name</span>
              <input name="name" type="text" autocomplete="name" maxlength="100" required />
            </label>
            <label>
              <span>Email address</span>
              <input name="email" type="email" autocomplete="email" maxlength="254" required />
            </label>
          </div>
          <label>
            <span>Subject</span>
            <input name="subject" type="text" maxlength="150" required />
          </label>
          <label>
            <span>Message</span>
            <textarea name="message" rows="6" maxlength="5000" required></textarea>
          </label>
          <div class="contact-form__trap" aria-hidden="true">
            <label>Leave this field empty<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="contact-form__actions">
            <button class="contact-form__submit" type="submit">Send message</button>
            <p class="contact-form__status" id="contact-form-status" role="status" aria-live="polite"></p>
          </div>
          <p class="contact-form__privacy">Your email address will only be used to respond to your enquiry.</p>
        </form>
      </section>

    </Container>
  </section>
</BaseLayout>

<style>
  .contact-form-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border, #d9dee7);
  }

  .contact-form-heading {
    max-width: 680px;
    margin-bottom: 1.75rem;
  }

  .contact-form-heading h2 {
    margin: 0.4rem 0 0.75rem;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
  }

  .contact-form-heading > p:last-child,
  .contact-form__privacy {
    color: var(--color-muted, #64748b);
    line-height: 1.7;
  }

  .contact-form {
    display: grid;
    gap: 1.15rem;
    max-width: 820px;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-border, #d9dee7);
    border-radius: 1rem;
    background: var(--color-surface, #fff);
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-form label {
    display: grid;
    gap: 0.5rem;
    color: var(--color-text, #334155);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    min-width: 0;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--color-border, #cbd5e1);
    border-radius: 0.55rem;
    background: var(--color-background, #fff);
    color: inherit;
    font: inherit;
    font-weight: 400;
  }

  .contact-form textarea {
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--color-text, #334155);
    outline-offset: 2px;
  }

  .contact-form__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .contact-form__submit {
    min-height: 2.8rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--color-text, #0f172a);
    border-radius: 0.55rem;
    background: var(--color-text, #0f172a);
    color: white;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .contact-form__submit:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .contact-form__status {
    margin: 0;
    color: var(--color-text, #334155);
    font-size: 0.9rem;
  }

  .contact-form__privacy {
    margin: 0;
    font-size: 0.82rem;
  }

  .contact-form__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .contact-form__grid {
      grid-template-columns: 1fr;
    }
  }

</style>

<script>
  const contactCopyBtn = document.querySelector<HTMLButtonElement>('[data-contact-copy-btn]');
  const contactCopyText = document.querySelector<HTMLElement>('[data-contact-copy-text]');
  const contactCopyIcon = document.querySelector<HTMLElement>('[data-contact-copy-icon]');

  let resetTimeout: number | undefined;

  contactCopyBtn?.addEventListener('click', async (e) => {
    e.preventDefault();
    const email = contactCopyBtn.dataset.email || 'contact@balkrishnajha.com.np';
    try {
      await navigator.clipboard.writeText(email);
      contactCopyBtn.classList.add('is-copied');
      const isNepali = document.documentElement.lang === 'ne';
      if (contactCopyText) contactCopyText.textContent = isNepali ? 'कपि भयो!' : 'Copied!';
      if (contactCopyIcon) {
        contactCopyIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>';
      }
      if (resetTimeout) window.clearTimeout(resetTimeout);
      resetTimeout = window.setTimeout(() => {
        contactCopyBtn.classList.remove('is-copied');
        if (contactCopyText) {
          contactCopyText.textContent = isNepali ? (contactCopyText.dataset.ne ?? 'कपि') : (contactCopyText.dataset.en ?? 'Copy');
        }
        if (contactCopyIcon) {
          contactCopyIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 9h10a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1"/></svg>';
        }
      }, 2200);
    } catch {
      window.prompt('Copy email address:', email);
    }
  });

  document.addEventListener('bkj-language-change', () => {
    if (contactCopyText && !contactCopyBtn?.classList.contains('is-copied')) {
      const isNepali = document.documentElement.lang === 'ne';
      contactCopyText.textContent = isNepali ? (contactCopyText.dataset.ne ?? 'कपि') : (contactCopyText.dataset.en ?? 'Copy');
    }
  });
</script>
