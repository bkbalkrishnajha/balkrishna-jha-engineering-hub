---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import Container from '@components/Container.astro';
import NepaliTimeCalendar from '@components/NepaliTimeCalendar.astro';
---
<BaseLayout title="Nepali Calendar & Panchang" description="Nepal time, Bikram Sambat calendar, daily Panchang reference and official public holiday sources.">
  <PageIntro eyebrow="Nepal time and calendar" title="Nepali calendar and Panchang" description="A practical reference for Bikram Sambat dates, Nepal time, daily Panchang information and public holiday references." nepaliEyebrow="नेपाल समय र पात्रो" nepaliTitle="नेपाली पात्रो र पञ्चाङ्ग" nepaliDescription="विक्रम संवत् मिति, नेपालको समय र दैनिक पञ्चाङ्ग जानकारीका लागि उपयोगी सन्दर्भ।" />
  <NepaliTimeCalendar />
  <section class="section calendar-more-links"><Container><a class="button button--secondary" href="/calendar/date-converter/">Open AD ↔ BS date converter</a><p class="calendar-data-note">Calendar conversion and astronomical Panchang data are provided by separate sources. Public holiday dates should always be checked against the relevant Government of Nepal notice.</p></Container></section>
</BaseLayout>
