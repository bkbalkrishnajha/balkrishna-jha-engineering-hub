---
import Icon from '@components/Icon.astro';
interface Props { showPanchang?: boolean }
const { showPanchang = true } = Astro.props;
---
<section class="section nepali-time-section" data-nepali-widget aria-labelledby="nepali-widget-title">
  <div class="site-container">
    <div class="nepali-widget-heading">
      <div>
        <p class="eyebrow">Nepal Standard Time · NPT</p>
        <h2 id="nepali-widget-title" data-en="Nepal time, calendar and year progress" data-ne="नेपालको समय, पात्रो र वार्षिक प्रगति">Nepal time, calendar and year progress</h2>
        <p class="nepali-widget-description" data-en="Nepal local time, Bikram Sambat date and current-year progress in one place." data-ne="नेपालको स्थानीय समय, विक्रम संवत् मिति र चालु वर्षको प्रगति एकै ठाउँमा।">Nepal local time, Bikram Sambat date and current-year progress in one place.</p>
      </div>
      <div class="nepali-zone-badge"><Icon name="globe" size={17} /> <span>Asia/Kathmandu</span><strong>UTC +05:45</strong></div>
    </div>

    <div class="nepali-widget-grid">
      <section class="nepali-calendar-panel" aria-label="Nepali date and calendar">
        <div class="nepali-clock-panel">
          <div>
            <span class="nepali-clock-label" data-en="Nepal time" data-ne="नेपाल समय">Nepal time</span>
            <time class="nepali-clock-time" data-nepal-time aria-live="off">--:--:--</time>
            <p class="nepali-clock-date" data-nepali-full-date>मिति लोड हुँदैछ…</p>
          </div>
          <div class="nepali-clock-analog" role="img" aria-label="Live analog clock showing Nepal Standard Time">
            {Array.from({ length: 12 }, (_, i) => <span class="clock-mark" style={`--i:${i}`} aria-hidden="true"></span>)}
            <span class="clock-hand clock-hand--hour" data-nepal-hour-hand></span>
            <span class="clock-hand clock-hand--minute" data-nepal-minute-hand></span>
            <span class="clock-hand clock-hand--second" data-nepal-second-hand></span>
            <span class="clock-pin"></span>
          </div>
        </div>

        <div class="nepali-calendar-head">
          <div>
            <p class="nepali-calendar-overline" data-en="Bikram Sambat calendar" data-ne="विक्रम संवत् पात्रो">Bikram Sambat calendar</p>
            <h3 data-calendar-title>पात्रो लोड हुँदैछ…</h3>
            <p class="nepali-calendar-today" data-calendar-today-label></p>
          </div>
          <div class="nepali-calendar-controls" aria-label="Calendar navigation">
            <button type="button" data-calendar-prev aria-label="अघिल्लो महिना"><span aria-hidden="true">‹</span></button>
            <button type="button" data-calendar-reset aria-label="Today">Today</button>
            <button type="button" data-calendar-next aria-label="अर्को महिना"><span aria-hidden="true">›</span></button>
          </div>
        </div>

        <div class="nepali-calendar-weekdays" aria-hidden="true">
          <span data-en="Sun" data-ne="आइत">Sun</span><span data-en="Mon" data-ne="सोम">Mon</span><span data-en="Tue" data-ne="मंगल">Tue</span><span data-en="Wed" data-ne="बुध">Wed</span><span data-en="Thu" data-ne="बिहि">Thu</span><span data-en="Fri" data-ne="शुक्र">Fri</span><span data-en="Sat" data-ne="शनि">Sat</span>
        </div>
        <div class="nepali-calendar-grid" data-calendar-grid aria-label="महिनाको दिनहरू">
          <span class="nepali-calendar-loading">पात्रो तयार हुँदैछ…</span>
        </div>
        <div class="nepali-calendar-foot">
          <span><i aria-hidden="true"></i> <span data-en="Today" data-ne="आजको मिति">Today</span></span>
          <span class="nepali-holiday-legend"><i aria-hidden="true"></i> <span data-en="Public holiday" data-ne="सार्वजनिक बिदा">Public holiday</span></span>
          <span data-gregorian-date></span>
        </div>

        {showPanchang && <section class="panchang-inline" aria-labelledby="panchang-title" data-panchang-panel>
          <div class="panchang-inline-heading">
            <div>
              <p class="eyebrow" data-en="Daily lunar almanac" data-ne="दैनिक पञ्चाङ्ग">Daily lunar almanac</p>
              <h3 id="panchang-title" data-en="Panchang · Kathmandu" data-ne="पञ्चाङ्ग · काठमाडौं">Panchang · Kathmandu</h3>
            </div>
            <span class="panchang-location">27.7172° N · 85.3240° E</span>
          </div>
          <div class="panchang-values" data-panchang-values aria-live="polite">
            {['Tithi', 'Paksha', 'Nakshatra', 'Yoga', 'Karana', 'Sunrise', 'Sunset'].map((label) => <div class="panchang-value"><span>{label}</span><strong>Loading…</strong></div>)}
          </div>
          <details class="panchang-debug">
            <summary data-en="Provider response / troubleshooting" data-ne="प्रदायकको प्रतिक्रिया / समस्या पहिचान">Provider response / troubleshooting</summary>
            <pre class="panchang-raw-output" data-panchang-raw>Waiting for provider response…</pre>
          </details>
          <p class="calendar-data-note" data-en="Daily values are supplied by the external Panchang provider. Missing fields are shown as unavailable; no values are estimated." data-ne="दैनिक विवरण बाह्य पञ्चाङ्ग प्रदायकबाट प्राप्त हुन्छ। उपलब्ध नभएका विवरणलाई अनुपलब्ध देखाइन्छ; अनुमानित मान राखिँदैन।">Daily values are supplied by the external Panchang provider. Missing fields are shown as unavailable; no values are estimated.</p>
          <a href="https://api.khumnath.com.np/" target="_blank" rel="noopener noreferrer">Panchang API provider</a>
        </section>}

        <dialog class="holiday-detail-dialog" data-holiday-dialog aria-labelledby="holiday-dialog-title">
          <form method="dialog" class="holiday-dialog-form">
            <button class="holiday-dialog-close" aria-label="Close holiday details">×</button>
            <p class="eyebrow" data-en="Public holiday details" data-ne="सार्वजनिक बिदाको विवरण">Public holiday details</p>
            <h3 id="holiday-dialog-title" data-holiday-name></h3>
            <p data-holiday-date></p>
            <p><strong data-en="Scope:" data-ne="लागू हुने क्षेत्र:">Scope:</strong> <span data-holiday-scope></span></p>
            <a href="https://moha.gov.np/en/page/government-and-public-holidays-in-2083" target="_blank" rel="noopener noreferrer" data-en="Government of Nepal · MOHA source" data-ne="नेपाल सरकार · गृह मन्त्रालयको स्रोत">Government of Nepal · MOHA source</a>
          </form>
        </dialog>
      </section>

      <aside class="nepali-year-panel" aria-label="Bikram Sambat year completion">
        <div class="nepali-year-panel-head">
          <div>
            <p class="eyebrow">Annual overview</p>
            <h3 data-en="Year progress" data-ne="वर्ष प्रगति">Year progress</h3>
            <p class="nepali-year-subtitle" data-en="Current Bikram Sambat year completion" data-ne="चालु विक्रम संवत् वर्षको पूर्णता">Current Bikram Sambat year completion</p>
          </div>
          <span class="nepali-year-badge" data-year-badge>वि.सं.</span>
        </div>

        <div class="nepali-year-progress-main">
          <div class="nepali-progress-ring" role="progressbar" aria-label="विक्रम संवत् वर्षको प्रगति" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-year-progress>
            <svg viewBox="0 0 112 112" aria-hidden="true">
              <circle class="nepali-progress-ring-track" cx="56" cy="56" r="47"></circle>
              <circle class="nepali-progress-ring-value" cx="56" cy="56" r="47" data-progress-ring></circle>
            </svg>
            <div class="nepali-progress-ring-copy"><strong data-year-percent>--%</strong><span data-en="complete" data-ne="पूरा">complete</span></div>
          </div>
          <div class="nepali-year-stats">
            <strong data-year-title>२०८३</strong>
            <span data-en="Bikram Sambat" data-ne="विक्रम संवत्">Bikram Sambat</span>
            <p data-year-summary>वार्षिक प्रगति गणना हुँदैछ…</p>
          </div>
        </div>

        <div class="nepali-year-bar" role="presentation"><span data-year-bar></span></div>
        <div class="nepali-year-range">
          <span data-days-elapsed>-- दिन पूरा</span>
          <span data-days-remaining>-- दिन बाँकी</span>
        </div>

        <div class="nepali-month-chart-heading"><span data-en="Progress by month" data-ne="महिनाअनुसार प्रगति">Progress by month</span><span data-en="Baisakh – Chaitra" data-ne="बैशाख – चैत्र">Baisakh – Chaitra</span></div>
        <div class="nepali-month-chart" data-year-chart role="img" aria-label="विक्रम संवत् वर्षको महिनाअनुसार प्रगति"></div>
        <p class="nepali-year-footnote" data-en="Calculated from the actual start and end dates of the BS year." data-ne="वर्षको वास्तविक सुरु र अन्त्य मितिका आधारमा गणना गरिएको।">Calculated from the actual start and end dates of the BS year.</p>
      </aside>
    </div>
  </div>
</section>

<script>
  import NepaliDate from 'nepali-date-converter';
  import { holidays2083 } from '@data/holidays-2083';

  type BsDateParts = { year: number; month: number; day: number };
  type MonthDay = { date: Date; day: number };

  const MONTHS_NP = ['बैशाख', 'जेठ', 'असार', 'श्रावण', 'भदौ', 'असोज', 'कार्तिक', 'मंसिर', 'पुष', 'माघ', 'फाल्गुन', 'चैत्र'];
  const MONTHS_SHORT = ['बै', 'जे', 'असा', 'श्रा', 'भा', 'असो', 'का', 'मंसि', 'पौ', 'मा', 'फा', 'चै'];
  const MONTHS_EN = ['Baisakh', 'Jestha', 'Asar', 'Shrawan', 'Bhadra', 'Ashwin', 'Kartik', 'Mangsir', 'Poush', 'Magh', 'Falgun', 'Chaitra'];
  const MONTHS_SHORT_EN = ['Bai', 'Jes', 'Asa', 'Shr', 'Bha', 'Ash', 'Kar', 'Man', 'Pou', 'Mag', 'Fal', 'Cha'];
  const WEEKDAYS_EN = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const isEnglish = (): boolean => document.documentElement.lang !== 'ne';
  const formatDigits = (value: number | string): string => isEnglish() ? String(value) : toNepaliDigits(value);
  const WEEKDAYS_NP = ['आइतबार', 'सोमबार', 'मंगलबार', 'बुधबार', 'बिहीबार', 'शुक्रबार', 'शनिबार'];
  const NEPALI_DIGITS = '०१२३४५६७८९';
  const DAY_MS = 86_400_000;
  const RING_CIRCUMFERENCE = 2 * Math.PI * 47;

  const toNepaliDigits = (value: number | string): string => String(value).replace(/[0-9]/g, (digit) => NEPALI_DIGITS[Number(digit)]);

  // The converter receives a local-noon Date so the Gregorian calendar day is
  // stable even when a visitor's computer is set to a different time zone.
  const getBsParts = (date: Date): BsDateParts => {
    const formatted = new NepaliDate(date).format('YYYY-MM-DD');
    const [year, month, day] = formatted.split(/[-/]/).map(Number);
    if (!year || !month || !day || month < 1 || month > 12) {
      throw new Error(`Unexpected Bikram Sambat date returned by converter: ${formatted}`);
    }
    return { year, month, day };
  };

  const localNoon = (year: number, month: number, day: number): Date => new Date(year, month - 1, day, 12, 0, 0, 0);
  const shiftDays = (date: Date, amount: number): Date => {
    const shifted = new Date(date);
    shifted.setDate(shifted.getDate() + amount);
    return shifted;
  };
  const serialDay = (date: Date): number => Date.UTC(date.getFullYear(), date.getMonth(), date.getDate());
  const daysBetween = (from: Date, to: Date): number => Math.round((serialDay(to) - serialDay(from)) / DAY_MS);

  const getNepalToday = (): Date => {
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Kathmandu', year: 'numeric', month: '2-digit', day: '2-digit',
    }).formatToParts(new Date());
    const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));
    return localNoon(Number(values.year), Number(values.month), Number(values.day));
  };

  const formatNepalDate = (date: Date): string => {
    const parts = getBsParts(date);
    return isEnglish() ? `${WEEKDAYS_EN[date.getDay()]}, ${parts.day} ${MONTHS_EN[parts.month - 1]} ${parts.year} BS` : `${WEEKDAYS_NP[date.getDay()]}, ${toNepaliDigits(parts.day)} ${MONTHS_NP[parts.month - 1]} ${toNepaliDigits(parts.year)}`;
  };

  const findMonthStart = (date: Date, parts: BsDateParts): Date => {
    let start = new Date(date);
    for (let index = 0; index < 34; index += 1) {
      const previous = shiftDays(start, -1);
      const previousParts = getBsParts(previous);
      if (previousParts.year !== parts.year || previousParts.month !== parts.month) break;
      start = previous;
    }
    return start;
  };

  const getMonthDays = (start: Date, year: number, month: number): MonthDay[] => {
    const days: MonthDay[] = [];
    let cursor = new Date(start);
    for (let index = 0; index < 34; index += 1) {
      const parts = getBsParts(cursor);
      if (parts.year !== year || parts.month !== month) break;
      days.push({ date: new Date(cursor), day: parts.day });
      cursor = shiftDays(cursor, 1);
    }
    return days;
  };

  const getYearBounds = (today: Date, year: number): { start: Date; end: Date } => {
    let start = new Date(today);
    let end = new Date(today);

    for (let index = 0; index < 370; index += 1) {
      const previous = shiftDays(start, -1);
      if (getBsParts(previous).year !== year) break;
      start = previous;
    }
    for (let index = 0; index < 370; index += 1) {
      const next = shiftDays(end, 1);
      if (getBsParts(next).year !== year) break;
      end = next;
    }
    return { start, end };
  };

  const widget = document.querySelector<HTMLElement>('[data-nepali-widget]');
  if (widget) {
    const timeNode = widget.querySelector<HTMLTimeElement>('[data-nepal-time]');
    const fullDateNode = widget.querySelector<HTMLElement>('[data-nepali-full-date]');
    const gregorianNode = widget.querySelector<HTMLElement>('[data-gregorian-date]');
    const calendarTitle = widget.querySelector<HTMLElement>('[data-calendar-title]');
    const calendarToday = widget.querySelector<HTMLElement>('[data-calendar-today-label]');
    const calendarGrid = widget.querySelector<HTMLElement>('[data-calendar-grid]');
    const yearBadge = widget.querySelector<HTMLElement>('[data-year-badge]');
    const yearTitle = widget.querySelector<HTMLElement>('[data-year-title]');
    const yearPercent = widget.querySelector<HTMLElement>('[data-year-percent]');
    const yearSummary = widget.querySelector<HTMLElement>('[data-year-summary]');
    const daysElapsed = widget.querySelector<HTMLElement>('[data-days-elapsed]');
    const daysRemaining = widget.querySelector<HTMLElement>('[data-days-remaining]');
    const yearBar = widget.querySelector<HTMLElement>('[data-year-bar]');
    const yearRing = widget.querySelector<SVGCircleElement>('[data-progress-ring]');
    const yearProgress = widget.querySelector<HTMLElement>('[data-year-progress]');
    const yearChart = widget.querySelector<HTMLElement>('[data-year-chart]');
    const previousButton = widget.querySelector<HTMLButtonElement>('[data-calendar-prev]');
    const nextButton = widget.querySelector<HTMLButtonElement>('[data-calendar-next]');
    const todayButton = widget.querySelector<HTMLButtonElement>('[data-calendar-reset]');
    const hourHand = widget.querySelector<HTMLElement>('[data-nepal-hour-hand]');
    const minuteHand = widget.querySelector<HTMLElement>('[data-nepal-minute-hand]');
    const secondHand = widget.querySelector<HTMLElement>('[data-nepal-second-hand]');
    const holidayDialog = widget.querySelector<HTMLDialogElement>('[data-holiday-dialog]');

    const formatTime = (date: Date): string => new Intl.DateTimeFormat(isEnglish() ? 'en-NP' : 'ne-NP', {
      timeZone: 'Asia/Kathmandu', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true,
    }).format(date);
    const formatGregorian = (date: Date): string => new Intl.DateTimeFormat(isEnglish() ? 'en-GB' : 'ne-NP', {
      timeZone: 'Asia/Kathmandu', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    }).format(date);

    let today = getNepalToday();
    let todayParts = getBsParts(today);
    let viewStart = findMonthStart(today, todayParts);

    const updateClock = (): void => {
      const now = new Date();
      if (timeNode) {
        timeNode.textContent = formatTime(now);
        timeNode.dateTime = now.toISOString();
      }
      const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kathmandu', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }).formatToParts(now);
      const clock = Object.fromEntries(parts.map((part) => [part.type, Number(part.value)]));
      const hour = (clock.hour % 12) * 30 + clock.minute * 0.5;
      const minute = clock.minute * 6 + clock.second * 0.1;
      if (hourHand) hourHand.style.transform = `translateX(-50%) rotate(${hour}deg)`;
      if (minuteHand) minuteHand.style.transform = `translateX(-50%) rotate(${minute}deg)`;
      if (secondHand) secondHand.style.transform = `translateX(-50%) rotate(${clock.second * 6}deg)`;
    };

    const renderCalendar = (): void => {
      if (!calendarGrid) return;
      const firstParts = getBsParts(viewStart);
      if (calendarTitle) calendarTitle.textContent = isEnglish() ? `${MONTHS_EN[firstParts.month - 1]} ${firstParts.year}` : `${MONTHS_NP[firstParts.month - 1]} ${toNepaliDigits(firstParts.year)}`;
      if (calendarToday) calendarToday.textContent = firstParts.year === todayParts.year && firstParts.month === todayParts.month
        ? (isEnglish() ? `Today: ${todayParts.day}` : `आज ${toNepaliDigits(todayParts.day)} गते`)
        : (isEnglish() ? 'Bikram Sambat' : 'विक्रम संवत्');

      const days = getMonthDays(viewStart, firstParts.year, firstParts.month);
      const cells: (MonthDay | null)[] = Array.from({ length: viewStart.getDay() }, () => null);
      cells.push(...days);
      while (cells.length % 7 !== 0) cells.push(null);

      const fragment = document.createDocumentFragment();
      cells.forEach((cell) => {
        if (!cell) {
          const blank = document.createElement('span');
          blank.className = 'nepali-calendar-day is-empty';
          blank.setAttribute('aria-hidden', 'true');
          fragment.append(blank);
          return;
        }
        const parts = getBsParts(cell.date);
        const holiday = parts.year === 2083 ? holidays2083[`${parts.month}-${parts.day}`] : undefined;
        const day: HTMLButtonElement | HTMLSpanElement = holiday ? document.createElement('button') : document.createElement('span');
        day.className = 'nepali-calendar-day';
        day.textContent = toNepaliDigits(cell.day);
        if (day instanceof HTMLButtonElement) {
          day.type = 'button';
          day.dataset.holidayKey = `${parts.month}-${parts.day}`;
          day.setAttribute('aria-haspopup', 'dialog');
        }
        const isToday = parts.year === todayParts.year && parts.month === todayParts.month && parts.day === todayParts.day;
        if (holiday) { day.classList.add('is-holiday'); day.title = `${holiday.name} · ${holiday.scope}`; day.setAttribute('aria-label', `${toNepaliDigits(cell.day)} ${MONTHS_NP[parts.month - 1]}: ${holiday.name}`); }
        if (isToday) {
          day.classList.add('is-today');
          day.setAttribute('aria-current', 'date');
          day.title = isEnglish() ? 'Today' : 'आजको मिति';
        }
        fragment.append(day);
      });
      calendarGrid.replaceChildren(fragment);
    };

    const openHolidayDetails = (button: HTMLButtonElement): void => {
      const key = button.dataset.holidayKey;
      const holiday = key ? holidays2083[key] : undefined;
      if (!holiday || !holidayDialog) return;
      const [month, day] = key!.split('-').map(Number);
      const name = holidayDialog.querySelector<HTMLElement>('[data-holiday-name]');
      const date = holidayDialog.querySelector<HTMLElement>('[data-holiday-date]');
      const scope = holidayDialog.querySelector<HTMLElement>('[data-holiday-scope]');
      if (name) name.textContent = holiday.name;
      if (date) date.textContent = isEnglish() ? `${day} ${MONTHS_EN[month - 1]} 2083 BS` : `${toNepaliDigits(day)} ${MONTHS_NP[month - 1]} ${toNepaliDigits(2083)} वि.सं.`;
      if (scope) scope.textContent = isEnglish()
        ? ({ national: 'National', regional: 'Regional', conditional: 'Conditional / applicable to specified groups' } as const)[holiday.scope]
        : ({ national: 'राष्ट्रिय', regional: 'क्षेत्रीय', conditional: 'सर्तसहित / तोकिएका समुदायमा लागू' } as const)[holiday.scope];
      if (!holidayDialog.open) holidayDialog.showModal();
    };
    calendarGrid?.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element) {
        const button = target.closest<HTMLButtonElement>('button[data-holiday-key]');
        if (button) openHolidayDetails(button);
      }
    });

    const renderYearProgress = (): void => {
      const { start, end } = getYearBounds(today, todayParts.year);
      const total = daysBetween(start, end) + 1;
      const elapsed = Math.min(total, Math.max(1, daysBetween(start, today) + 1));
      const remaining = Math.max(0, total - elapsed);
      const percent = Math.min(100, (elapsed / total) * 100);
      const percentText = `${formatDigits(percent.toFixed(1))}%`;

      if (yearBadge) yearBadge.textContent = isEnglish() ? `BS ${todayParts.year}` : `वि.सं. ${toNepaliDigits(todayParts.year)}`;
      if (yearTitle) yearTitle.textContent = formatDigits(todayParts.year);
      if (yearPercent) yearPercent.textContent = percentText;
      if (yearSummary) yearSummary.textContent = isEnglish() ? `${elapsed} of ${total} days completed.` : `${toNepaliDigits(total)} दिनको वर्षमध्ये ${toNepaliDigits(elapsed)} दिन पूरा।`;
      if (daysElapsed) daysElapsed.textContent = isEnglish() ? `${elapsed} days elapsed` : `${toNepaliDigits(elapsed)} दिन पूरा`;
      if (daysRemaining) daysRemaining.textContent = isEnglish() ? `${remaining} days remaining` : `${toNepaliDigits(remaining)} दिन बाँकी`;
      if (yearBar) yearBar.style.width = `${percent}%`;
      if (yearRing) yearRing.style.strokeDashoffset = String(RING_CIRCUMFERENCE * (1 - percent / 100));
      if (yearProgress) yearProgress.setAttribute('aria-valuenow', percent.toFixed(1));

      // Build a twelve-column month graph from the actual BS year boundaries.
      const monthTotals = Array.from({ length: 12 }, () => ({ total: 0, elapsed: 0 }));
      for (let cursor = new Date(start); serialDay(cursor) <= serialDay(end); cursor = shiftDays(cursor, 1)) {
        const parts = getBsParts(cursor);
        const data = monthTotals[parts.month - 1];
        if (data) {
          data.total += 1;
          if (serialDay(cursor) <= serialDay(today)) data.elapsed += 1;
        }
      }
      if (yearChart) {
        const fragment = document.createDocumentFragment();
        monthTotals.forEach((data, index) => {
          const column = document.createElement('div');
          column.className = 'nepali-month-column';
          const fraction = data.total ? (data.elapsed / data.total) * 100 : 0;
          const label = isEnglish() ? `${MONTHS_EN[index]}: ${data.elapsed} / ${data.total} days` : `${MONTHS_NP[index]}: ${toNepaliDigits(data.elapsed)} / ${toNepaliDigits(data.total)} दिन`;
          column.title = label;
          column.setAttribute('aria-label', label);
          const track = document.createElement('span');
          track.className = 'nepali-month-track';
          const fill = document.createElement('span');
          fill.className = 'nepali-month-fill';
          fill.style.height = `${fraction}%`;
          if (index + 1 === todayParts.month) fill.classList.add('is-current');
          track.append(fill);
          const monthLabel = document.createElement('span');
          monthLabel.className = 'nepali-month-label';
          monthLabel.textContent = isEnglish() ? MONTHS_SHORT_EN[index] : MONTHS_SHORT[index];
          column.append(track, monthLabel);
          fragment.append(column);
        });
        yearChart.replaceChildren(fragment);
      }
    };

    const refreshNepalDate = (): void => {
      today = getNepalToday();
      todayParts = getBsParts(today);
      if (fullDateNode) fullDateNode.textContent = formatNepalDate(today);
      if (gregorianNode) gregorianNode.textContent = formatGregorian(new Date());
      renderCalendar();
      renderYearProgress();
    };

    const goToAdjacentMonth = (direction: -1 | 1): void => {
      const currentParts = getBsParts(viewStart);
      if (direction > 0) {
        let cursor = new Date(viewStart);
        for (let index = 0; index < 34; index += 1) {
          cursor = shiftDays(cursor, 1);
          const parts = getBsParts(cursor);
          if (parts.year !== currentParts.year || parts.month !== currentParts.month) {
            viewStart = cursor;
            break;
          }
        }
      } else {
        let cursor = shiftDays(viewStart, -1);
        const targetParts = getBsParts(cursor);
        for (let index = 0; index < 34; index += 1) {
          const previous = shiftDays(cursor, -1);
          const parts = getBsParts(previous);
          if (parts.year !== targetParts.year || parts.month !== targetParts.month) break;
          cursor = previous;
        }
        viewStart = cursor;
      }
      renderCalendar();
    };

    previousButton?.addEventListener('click', () => goToAdjacentMonth(-1));
    nextButton?.addEventListener('click', () => goToAdjacentMonth(1));
    todayButton?.addEventListener('click', () => {
      viewStart = findMonthStart(today, todayParts);
      renderCalendar();
    });

    const panchangValues = widget.querySelector<HTMLElement>('[data-panchang-values]');
    const panchangRaw = widget.querySelector<HTMLElement>('[data-panchang-raw]');
    const panchangLabels = [
      { key: 'tithi', en: 'Tithi', ne: 'तिथि', aliases: ['tithi', 'तिथि'] },
      { key: 'paksha', en: 'Paksha', ne: 'पक्ष', aliases: ['paksha', 'fortnight', 'पक्ष'] },
      { key: 'nakshatra', en: 'Nakshatra', ne: 'नक्षत्र', aliases: ['nakshatra', 'नक्षत्र'] },
      { key: 'yoga', en: 'Yoga', ne: 'योग', aliases: ['yoga', 'योग'] },
      { key: 'karana', en: 'Karana', ne: 'करण', aliases: ['karana', 'करण'] },
      { key: 'sunrise', en: 'Sunrise', ne: 'सूर्योदय', aliases: ['sunrise', 'sun rise', 'सूर्योदय'] },
      { key: 'sunset', en: 'Sunset', ne: 'सूर्यास्त', aliases: ['sunset', 'sun set', 'सूर्यास्त'] },
    ];
    const extractPanchangFields = (body: string): Record<string, string> => {
      const found: Record<string, string> = {};
      const lines = body.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
      for (const item of panchangLabels) {
        const aliases = item.aliases.map((alias) => alias.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
        const labelPattern = new RegExp(`^(?:[-*•]\\s*)?(?:${aliases.join('|')})\\s*(?::|=|–|—|-)\\s*(.+)$`, 'i');
        const match = lines.map((line) => line.match(labelPattern)).find(Boolean);
        if (match?.[1]) found[item.key] = match[1].trim();
      }
      return found;
    };
    const renderPanchang = (values: Record<string, string>): void => {
      if (!panchangValues) return;
      const fragment = document.createDocumentFragment();
      panchangLabels.forEach((item) => {
        const card = document.createElement('div');
        card.className = 'panchang-value';
        const label = document.createElement('span');
        label.textContent = isEnglish() ? item.en : item.ne;
        const value = document.createElement('strong');
        value.textContent = values[item.key] || (isEnglish() ? 'Unavailable' : 'उपलब्ध छैन');
        card.append(label, value);
        fragment.append(card);
      });
      panchangValues.replaceChildren(fragment);
    };
    const loadPanchang = async (): Promise<void> => {
      if (!panchangValues || !panchangRaw) return;
      const language = isEnglish() ? 'en' : 'ne';
      renderPanchang({});
      panchangRaw.textContent = isEnglish() ? 'Loading provider response…' : 'प्रदायकको प्रतिक्रिया लोड हुँदैछ…';
      try {
        const url = `https://api.khumnath.com.np/today?format=text&lang=${language}&lat=27.7172&lon=85.3240&tz=5.75&elev=1400`;
        const response = await fetch(url, { headers: { Accept: 'text/plain' } });
        if (!response.ok) throw new Error(`HTTP ${response.status} ${response.statusText}`);
        const body = await response.text();
        if (!body.trim()) throw new Error('The provider returned an empty response.');
        panchangRaw.textContent = body.slice(0, 8000);
        renderPanchang(extractPanchangFields(body));
      } catch (error) {
        panchangRaw.textContent = error instanceof Error ? error.message : 'Unknown Panchang request error.';
        renderPanchang({});
      }
    };

    document.addEventListener('bkj-language-change', () => {
      if (fullDateNode) fullDateNode.textContent = formatNepalDate(today);
      renderCalendar();
      renderYearProgress();
      updateClock();
      loadPanchang();
    });
    updateClock();
    refreshNepalDate();
    loadPanchang();
    window.setInterval(updateClock, 1000);
    window.setInterval(() => {
      const currentNepalDay = getNepalToday();
      const currentParts = getBsParts(currentNepalDay);
      if (currentParts.year !== todayParts.year || currentParts.month !== todayParts.month || currentParts.day !== todayParts.day) {
        const wasViewingCurrentMonth = (() => {
          const viewParts = getBsParts(viewStart);
          return viewParts.year === todayParts.year && viewParts.month === todayParts.month;
        })();
        today = currentNepalDay;
        todayParts = currentParts;
        if (wasViewingCurrentMonth) viewStart = findMonthStart(today, todayParts);
        refreshNepalDate();
      } else {
        if (gregorianNode) gregorianNode.textContent = formatGregorian(new Date());
      }
    }, 30_000);
  }
</script>
