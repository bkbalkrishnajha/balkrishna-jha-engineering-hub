<!-- Search overlay modal — queries Supabase resources + posts in real time -->
<div id="search-modal" class="search-overlay" role="dialog" aria-modal="true" aria-label="Search" style="display:none;">
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel">
    <div class="search-header">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 21l-4.35-4.35"/><path d="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/></svg>
      <input id="search-input" type="search" placeholder="Search resources, blog posts…" autocomplete="off" autofocus />
      <button type="button" class="search-close-btn" data-search-close aria-label="Close search">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    <div class="search-results" id="search-results">
      <div class="search-hint">Type to search across resources and blog posts</div>
    </div>
    <div class="search-footer">
      <span><kbd>Esc</kbd> to close</span>
      <span><kbd>↵</kbd> to open</span>
    </div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: min(12vh, 120px);
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
  }
  .search-panel {
    position: relative;
    width: 95%;
    max-width: 620px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 70vh;
  }
  .search-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .search-header input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--ink);
    font-size: 1.05rem;
    font-family: var(--font-body);
  }
  .search-header input::placeholder {
    color: var(--muted);
    opacity: 0.7;
  }
  .search-close-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--surface-soft);
    color: var(--muted);
    cursor: pointer;
  }
  .search-close-btn:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .search-results {
    overflow-y: auto;
    padding: 8px;
    flex: 1;
    min-height: 80px;
  }
  .search-hint {
    padding: 2rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .search-section-label {
    padding: 8px 12px 4px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .search-item {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.12s;
  }
  .search-item:hover, .search-item:focus {
    background: var(--surface-soft);
    outline: none;
  }
  .search-item-title {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .search-item-meta {
    display: flex;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 2px;
  }
  .search-item-badge {
    display: inline-block;
    padding: 1px 6px;
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .search-no-results {
    padding: 2rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .search-loading {
    padding: 2rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .search-footer {
    display: flex;
    justify-content: flex-end;
    gap: 16px;
    padding: 8px 18px;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .search-footer kbd {
    display: inline-block;
    padding: 1px 5px;
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.68rem;
    font-weight: 600;
  }
</style>

<script>
  import { supabase } from '@lib/supabase';

  const modal = document.getElementById('search-modal') as HTMLElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsContainer = document.getElementById('search-results') as HTMLElement;
  let debounceTimer: ReturnType<typeof setTimeout>;

  // Category label helper
  const categoryLabels: Record<string, string> = {
    bachelor: 'Bachelor Civil',
    loksewa: 'Lok Sewa',
    codes: 'Codes & Laws',
    'engineering-reference': 'Eng. Reference',
    miscellaneous: 'Miscellaneous',
  };

  const categoryToSlug: Record<string, string> = {
    bachelor: 'bachelor-civil-engineering',
    loksewa: 'loksewa',
    codes: 'codes-and-laws',
    'engineering-reference': 'engineering-reference',
    miscellaneous: 'miscellaneous',
  };

  function openSearch() {
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => input.focus());
  }

  function closeSearch() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    input.value = '';
    resultsContainer.innerHTML = '<div class="search-hint">Type to search across resources and blog posts</div>';
  }

  // Open/close handlers
  document.querySelectorAll('[data-search-toggle]').forEach(btn =>
    btn.addEventListener('click', openSearch)
  );
  document.querySelectorAll('[data-search-close]').forEach(btn =>
    btn.addEventListener('click', closeSearch)
  );

  // Keyboard shortcut: Ctrl+K or Cmd+K
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      if (modal.style.display === 'none' || !modal.style.display) openSearch();
      else closeSearch();
    }
    if (e.key === 'Escape' && modal.style.display === 'flex') {
      closeSearch();
    }
  });

  // Search logic
  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const query = input.value.trim();
    if (!query) {
      resultsContainer.innerHTML = '<div class="search-hint">Type to search across resources and blog posts</div>';
      return;
    }
    if (query.length < 2) {
      resultsContainer.innerHTML = '<div class="search-hint">Keep typing…</div>';
      return;
    }
    resultsContainer.innerHTML = '<div class="search-loading">Searching…</div>';
    debounceTimer = setTimeout(() => performSearch(query), 250);
  });

  async function performSearch(query: string) {
    const pattern = `%${query}%`;

    const [resourcesRes, postsRes] = await Promise.all([
      supabase
        .from('resources')
        .select('id, title, description, category, created_at')
        .eq('is_published', true)
        .or(`title.ilike.${pattern},description.ilike.${pattern}`)
        .order('created_at', { ascending: false })
        .limit(10),
      supabase
        .from('posts')
        .select('id, title, excerpt, category, slug, created_at, cover_image')
        .eq('is_published', true)
        .or(`title.ilike.${pattern},excerpt.ilike.${pattern},content.ilike.${pattern}`)
        .order('created_at', { ascending: false })
        .limit(10),
    ]);

    const resources = resourcesRes.data ?? [];
    const posts = postsRes.data ?? [];

    if (resources.length === 0 && posts.length === 0) {
      resultsContainer.innerHTML = `<div class="search-no-results">No results found for "<strong>${escapeHtml(query)}</strong>"</div>`;
      return;
    }

    let html = '';

    if (resources.length > 0) {
      html += `<div class="search-section-label">📚 Resources (${resources.length})</div>`;
      html += resources.map((r: any) => {
        const slug = categoryToSlug[r.category] || 'miscellaneous';
        const label = categoryLabels[r.category] || r.category || '';
        return `
          <a class="search-item" href="/resources/${slug}/">
            <div class="search-item-title">${highlightMatch(escapeHtml(r.title), query)}</div>
            <div class="search-item-meta">
              ${label ? `<span class="search-item-badge">${escapeHtml(label)}</span>` : ''}
              ${r.description ? `<span>${escapeHtml(r.description.substring(0, 80))}${r.description.length > 80 ? '…' : ''}</span>` : ''}
            </div>
          </a>
        `;
      }).join('');
    }

    if (posts.length > 0) {
      html += `<div class="search-section-label">📝 Blog Posts (${posts.length})</div>`;
      html += posts.map((p: any) => {
        const href = p.slug ? `/blog/${p.slug}/` : '/blog/';
        return `
          <a class="search-item" href="${href}">
            <div class="search-item-title">${highlightMatch(escapeHtml(p.title), query)}</div>
            <div class="search-item-meta">
              ${p.category ? `<span class="search-item-badge">${escapeHtml(p.category)}</span>` : ''}
              ${p.excerpt ? `<span>${escapeHtml(p.excerpt.substring(0, 80))}${p.excerpt.length > 80 ? '…' : ''}</span>` : ''}
            </div>
          </a>
        `;
      }).join('');
    }

    resultsContainer.innerHTML = html;
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function highlightMatch(text: string, query: string): string {
    const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return text.replace(new RegExp(`(${escaped})`, 'gi'), '<mark style="background:rgba(56,189,248,0.25);color:inherit;padding:0 1px;border-radius:2px;">$1</mark>');
  }
</script>
