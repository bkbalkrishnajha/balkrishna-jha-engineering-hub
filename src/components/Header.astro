---
import { navigation, site } from '@data/site';
import Icon from './Icon.astro';
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="site-container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} — home`}>
      <img class="brand-logo" src="/images/bkj-logo-placeholder.svg" alt="BKJ logo placeholder" width="42" height="42" />
      <span class="brand-copy">
        <span class="brand-name">{site.name}</span>
        <span class="brand-subtitle">{site.profession}</span>
      </span>
    </a>

    <button class="mobile-menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
      <span data-menu-icon><Icon name="menu" size={21} /></span>
    </button>

    <nav class="primary-nav" id="primary-navigation" aria-label="Main navigation" data-navigation>
      {navigation.map((item) => { const nepali: Record<string, string> = { Home: 'गृहपृष्ठ', About: 'परिचय', Experience: 'अनुभव', Projects: 'परियोजनाहरू', 'Engineering Blog': 'इन्जिनियरिङ लेख', Resources: 'स्रोत सामग्री', 'Engineering Tools': 'इन्जिनियरिङ उपकरण', CV: 'जीवनवृत्त', Contact: 'सम्पर्क', 'Nepali Calendar': 'नेपाली पात्रो' }; return (
        <a href={item.href} class:list={['nav-link', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>
          <span data-en={item.label} data-ne={nepali[item.label] ?? item.label}>{item.label}</span>
        </a>
      ); })}
    </nav>

    <div class="header-actions">
      <div class="language-switch" role="group" aria-label="Choose language">
        <button type="button" data-language="en" aria-pressed="true">EN</button>
        <button type="button" data-language="ne" aria-pressed="false">नेपाली</button>
      </div>
    <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Toggle colour theme" data-theme-toggle>
      <span data-theme-icon><Icon name="moon" size={18} /></span>
    </button>
    </div>
  </div>
</header>
