---
import { navigation, site } from '@data/site';
import Icon from './Icon.astro';
const pathname = Astro.url.pathname;
const visibleNavigation = navigation.filter((item) => !['CV', 'Nepali Calendar'].includes(item.label));
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="site-container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} — home`}>
      <img class="brand-logo" src="/images/bkj-logo-placeholder.svg" alt="BKJ logo placeholder" width="42" height="42" />
      <span class="brand-copy">
        <span class="brand-name">{site.name}</span>
        <span class="brand-subtitle">{site.profession}</span>
      </span>
    </a>

    <button class="mobile-menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
      <span data-menu-icon><Icon name="menu" size={21} /></span>
    </button>

    <nav class="primary-nav" id="primary-navigation" aria-label="Main navigation" data-navigation>
      {visibleNavigation.map((item) => {
        const nepali: Record<string, string> = {
          Home: 'गृहपृष्ठ',
          About: 'परिचय',
          Experience: 'अनुभव',
          Projects: 'परियोजनाहरू',
          'Engineering Blog': 'इन्जिनियरिङ लेख',
          Resources: 'स्रोत सामग्री',
          'Engineering Tools': 'इन्जिनियरिङ उपकरण',
          Contact: 'सम्पर्क',
        };
        return (
          <a href={item.href} class:list={['nav-link', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span data-en={item.label} data-ne={nepali[item.label] ?? item.label}>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <a class="header-calendar" href="/calendar/" aria-label="Open Nepali calendar">
        <span class="header-calendar__label">NEPAL STANDARD TIME</span>
        <time class="header-calendar__time" data-header-nepal-time aria-live="off">--:--</time>
        <span class="header-calendar__date" data-header-nepal-date>मिति लोड हुँदैछ…</span>
      </a>
      <div class="language-switch" role="group" aria-label="Choose language">
        <button type="button" data-language="en" aria-pressed="true">EN</button>
        <button type="button" data-language="ne" aria-pressed="false">नेपाली</button>
      </div>
    <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Toggle colour theme" data-theme-toggle>
      <span data-theme-icon><Icon name="moon" size={18} /></span>
    </button>
    </div>
  </div>
</header>

<script>
  import NepaliDate from 'nepali-date-converter';

  const timeNode = document.querySelector<HTMLElement>('[data-header-nepal-time]');
  const dateNode = document.querySelector<HTMLElement>('[data-header-nepal-date]');
  const nepaliMonths = ['बैशाख', 'जेठ', 'असार', 'श्रावण', 'भदौ', 'असोज', 'कार्तिक', 'मंसिर', 'पुष', 'माघ', 'फाल्गुन', 'चैत्र'];
  const englishMonths = ['Baisakh', 'Jestha', 'Asar', 'Shrawan', 'Bhadra', 'Ashwin', 'Kartik', 'Mangsir', 'Poush', 'Magh', 'Falgun', 'Chaitra'];
  const nepaliDigits = '०१२३४५६७८९';
  const toNepaliDigits = (value: number | string): string => String(value).replace(/[0-9]/g, (digit) => nepaliDigits[Number(digit)]);

  const getNepalToday = (): Date => {
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Kathmandu', year: 'numeric', month: '2-digit', day: '2-digit',
    }).formatToParts(new Date());
    const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));
    return new Date(Number(values.year), Number(values.month) - 1, Number(values.day), 12, 0, 0, 0);
  };

  const updateHeaderCalendar = (): void => {
    const isNepali = document.documentElement.lang === 'ne';
    const now = new Date();
    if (timeNode) {
      timeNode.textContent = new Intl.DateTimeFormat(isNepali ? 'ne-NP' : 'en-NP', {
        timeZone: 'Asia/Kathmandu', hour: '2-digit', minute: '2-digit', hour12: true,
      }).format(now);
    }
    if (dateNode) {
      const [year, month, day] = new NepaliDate(getNepalToday()).format('YYYY-MM-DD').split(/[-/]/).map(Number);
      dateNode.textContent = isNepali
        ? `${toNepaliDigits(day)} ${nepaliMonths[month - 1]} ${toNepaliDigits(year)}`
        : `${day} ${englishMonths[month - 1]} ${year} BS`;
    }
  };

  updateHeaderCalendar();
  window.setInterval(updateHeaderCalendar, 30_000);
  document.addEventListener('bkj-language-change', updateHeaderCalendar);
</script>
