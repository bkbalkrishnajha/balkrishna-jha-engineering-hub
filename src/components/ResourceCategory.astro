---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import Container from '@components/Container.astro';

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  note?: string;
  nepaliTitle?: string;
  nepaliEyebrow?: string;
  nepaliDescription?: string;
  category?: string;
}

const { title, eyebrow, description, nepaliTitle, nepaliEyebrow, nepaliDescription, category } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <PageIntro
    eyebrow={eyebrow}
    title={title}
    description={description}
    nepaliEyebrow={nepaliEyebrow}
    nepaliTitle={nepaliTitle}
    nepaliDescription={nepaliDescription}
  />
  <section class="content-wrap">
    <Container>
      <div class="resource-subgrid" data-resource-category={category} id="category-resources-grid">
        <div class="resource-loading-state" id="category-loading-placeholder" style="grid-column: 1 / -1; padding: 2rem 0; color: var(--muted); text-align: center;">
          Loading resources...
        </div>
      </div>

      <div id="category-empty-state" class="empty-state" style="display: none; margin-top: 1.5rem;">
        <h3 data-en="Resources are being organized." data-ne="स्रोत सामग्रीहरू व्यवस्थित गरिँदैछ।">Resources are being organized.</h3>
        <p data-en="New study materials and references will appear here as they are published." data-ne="नयाँ अध्ययन सामग्री र सन्दर्भहरू यहाँ प्रकाशित हुँदै जानेछन्।">
          New study materials and references will appear here as they are published.
        </p>
      </div>

      <a class="text-link" href="/resources/" style="margin-top: 32px; display: inline-block;">← Back to all resources</a>
    </Container>
  </section>
</BaseLayout>

<script>
  import { supabase } from '@lib/supabase';

  function extractFiles(item: any): { title: string; url: string; size?: string }[] {
    if (item.files && Array.isArray(item.files) && item.files.length > 0) {
      return item.files;
    }
    if (item.file_url && typeof item.file_url === 'string') {
      const trimmed = item.file_url.trim();
      if (trimmed.startsWith('[') && trimmed.endsWith(']')) {
        try {
          const parsed = JSON.parse(trimmed);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        } catch (e) {}
      }
      if (item.file_url) {
        return [{ title: 'Download / View Resource', url: item.file_url, size: item.file_size || '' }];
      }
    }
    return [];
  }

  const container = document.querySelector<HTMLElement>('[data-resource-category]');
  const category = container?.dataset.resourceCategory;

  if (container && category) {
    const fetchResources = async () => {
      const { data, error } = await supabase
        .from('resources')
        .select('*')
        .eq('category', category)
        .eq('is_published', true)
        .order('created_at', { ascending: false });

      const placeholder = document.getElementById('category-loading-placeholder');
      const emptyState = document.getElementById('category-empty-state');

      if (!error && data && data.length > 0) {
        if (placeholder) placeholder.remove();
        if (emptyState) emptyState.style.display = 'none';
        container.innerHTML = data.map((item, index) => {
          const number = String(index + 1).padStart(2, '0');
          const filesList = extractFiles(item);

          let linksMarkup = '';
          if (filesList.length > 1) {
            linksMarkup = `
              <div class="resource-files-links" style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
                ${filesList.map((f: any) => `
                  <a class="feature-card__link" href="${f.url}" target="_blank" rel="noopener noreferrer" style="display: flex; justify-content: space-between; align-items: center; padding: 0.45rem 0.75rem; background: var(--surface-soft); border: 1px solid var(--line); border-radius: 6px; text-decoration: none; font-size: 0.85rem; font-weight: 600;">
                    <span>📄 ${f.title || 'Download Document'}</span>
                    <span style="font-size: 0.75rem; color: var(--muted);">${f.size ? f.size + ' ↗' : '↗'}</span>
                  </a>
                `).join('')}
              </div>
            `;
          } else if (filesList.length === 1) {
            const f = filesList[0];
            linksMarkup = `
              ${f.size ? `<span style="font-size: 0.75rem; color: var(--muted); margin-bottom: 0.5rem; display: block;">${f.size}</span>` : ''}
              <a class="feature-card__link" href="${f.url}" target="_blank" rel="noopener noreferrer">
                ${f.title || 'Download / View Resource'} <span aria-hidden="true">↗</span>
              </a>
            `;
          }

          return `
            <article class="feature-card resource-subcard">
              <span class="feature-card__number">${number} / RESOURCE</span>
              <h2>${item.title}</h2>
              ${item.description ? `<p style="white-space: pre-line;">${item.description}</p>` : ''}
              ${linksMarkup}
            </article>
          `;
        }).join('');
      } else {
        if (placeholder) placeholder.remove();
        container.style.display = 'none';
        if (emptyState) emptyState.style.display = 'block';
      }
    };

    fetchResources();
  }
</script>
