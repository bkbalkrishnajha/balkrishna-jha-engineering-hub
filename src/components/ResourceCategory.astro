---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import Container from '@components/Container.astro';

interface Item {
  title: string;
  description: string;
  href?: string;
}

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  items: Item[];
  note?: string;
  nepaliTitle?: string;
  nepaliEyebrow?: string;
  nepaliDescription?: string;
  category?: string;
}

const { title, eyebrow, description, items, nepaliTitle, nepaliEyebrow, nepaliDescription, category } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <PageIntro
    eyebrow={eyebrow}
    title={title}
    description={description}
    nepaliEyebrow={nepaliEyebrow}
    nepaliTitle={nepaliTitle}
    nepaliDescription={nepaliDescription}
  />
  <section class="content-wrap">
    <Container>
      <div class="resource-subgrid" data-resource-category={category}>
        {items.map((item, index) => (
          <article class="feature-card resource-subcard">
            <span class="feature-card__number">{String(index + 1).padStart(2, '0')} / TOPIC</span>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            {item.href && (
              <a class="feature-card__link" href={item.href}>
                Explore topic <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))}
      </div>
      <a class="text-link" href="/resources/" style="margin-top: 32px; display: inline-block;">← Back to all resources</a>
    </Container>
  </section>
</BaseLayout>

<script>
  import { supabase } from '@lib/supabase';

  const container = document.querySelector<HTMLElement>('[data-resource-category]');
  const category = container?.dataset.resourceCategory;

  if (container && category) {
    const fetchResources = async () => {
      const { data, error } = await supabase
        .from('resources')
        .select('*')
        .eq('category', category)
        .eq('is_published', true)
        .order('created_at', { ascending: false });

      if (!error && data && data.length > 0) {
        container.innerHTML = data.map((item, index) => {
          const number = String(index + 1).padStart(2, '0');
          const filesList = (item.files && Array.isArray(item.files) && item.files.length > 0)
            ? item.files
            : (item.file_url ? [{ title: 'Download / View Resource', url: item.file_url, size: item.file_size }] : []);

          let linksMarkup = '';
          if (filesList.length > 1) {
            linksMarkup = `
              <div class="resource-files-links" style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
                ${filesList.map((f: any) => `
                  <a class="feature-card__link" href="${f.url}" target="_blank" rel="noopener noreferrer" style="display: flex; justify-content: space-between; align-items: center; padding: 0.45rem 0.75rem; background: var(--surface-soft); border: 1px solid var(--line); border-radius: 6px; text-decoration: none; font-size: 0.85rem; font-weight: 600;">
                    <span>📄 ${f.title || 'Download Document'}</span>
                    <span style="font-size: 0.75rem; color: var(--muted);">${f.size ? f.size + ' ↗' : '↗'}</span>
                  </a>
                `).join('')}
              </div>
            `;
          } else if (filesList.length === 1) {
            const f = filesList[0];
            linksMarkup = `
              ${f.size ? `<span style="font-size: 0.75rem; color: var(--muted); margin-bottom: 0.5rem; display: block;">${f.size}</span>` : ''}
              <a class="feature-card__link" href="${f.url}" target="_blank" rel="noopener noreferrer">
                ${f.title || 'Download / View Resource'} <span aria-hidden="true">↗</span>
              </a>
            `;
          }

          return `
            <article class="feature-card resource-subcard">
              <span class="feature-card__number">${number} / RESOURCE</span>
              <h2>${item.title}</h2>
              ${item.description ? `<p>${item.description}</p>` : ''}
              ${linksMarkup}
            </article>
          `;
        }).join('');
      }
    };

    fetchResources();
  }
</script>
