---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---
<section class="page-intro">
  <div class="site-container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-intro__description">{description}</p>
  </div>
</section>
